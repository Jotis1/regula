{
	"ci": {
		"collect": {
			"startServerCommand": "bun run preview --port 4500",
			"startServerReadyPattern": "localhost:4500",
			"url": [
				"http://localhost:4500/",
				"http://localhost:4500/foundations/color/",
				"http://localhost:4500/components/button/"
			],
			"numberOfRuns": 3,
			"settings": {
				"chromeFlags": "--headless=new --no-sandbox"
			}
		},
		"assert": {
			"assertions": {
				"categories:performance": [
					"error",
					{
						"minScore": 0.9,
						"aggregationMethod": "median-run"
					}
				],
				"categories:accessibility": [
					"error",
					{
						"minScore": 0.9,
						"aggregationMethod": "median-run"
					}
				]
			}
		},
		"upload": {
			"target": "filesystem",
			"outputDir": "./.lighthouseci/reports"
		}
	}
}
