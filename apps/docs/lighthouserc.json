{
	"ci": {
		"collect": {
			"url": ["/", "/foundations/color/", "/components/button/", "/components/"],
			"numberOfRuns": 3,
			"settings": {
				"chromeFlags": "--headless=new --no-sandbox"
			},
			"staticDistDir": "./dist"
		},
		"assert": {
			"assertMatrix": [
				{
					"matchingUrlPattern": "^(?!.*/components/$).*$",
					"assertions": {
						"categories:performance": [
							"error",
							{ "minScore": 0.9, "aggregationMethod": "median-run" }
						],
						"categories:accessibility": [
							"error",
							{ "minScore": 0.9, "aggregationMethod": "median-run" }
						]
					}
				},
				{
					"matchingUrlPattern": "/components/$",
					"assertions": {
						"categories:performance": [
							"error",
							{ "minScore": 0.8, "aggregationMethod": "median-run" }
						],
						"categories:accessibility": [
							"error",
							{ "minScore": 0.9, "aggregationMethod": "median-run" }
						]
					}
				}
			]
		},
		"upload": {
			"target": "filesystem",
			"outputDir": "./.lighthouseci/reports"
		}
	}
}
