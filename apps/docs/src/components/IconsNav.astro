---
// Selector entre las galerías de recursos (iconos, logos, banderas, pagos, archivos y cursores): enlaces con el aspecto de las pestañas
// `button-minimal`, sin JavaScript. La página actual lleva `aria-current`.
interface Props {
	current: "icons" | "logos" | "flags" | "payments" | "files" | "cursors";
}
const { current } = Astro.props;
const links = [
	{ id: "icons", label: "Iconos", href: "/icons/" },
	{ id: "logos", label: "Logos", href: "/icons/logos/" },
	{ id: "flags", label: "Banderas", href: "/icons/flags/" },
	{ id: "payments", label: "Pagos", href: "/icons/payments/" },
	{ id: "files", label: "Archivos", href: "/icons/files/" },
	{ id: "cursors", label: "Cursores", href: "/icons/cursors/" },
] as const;
---

<nav aria-label="Iconos y recursos">
	<ul class="m-0 inline-flex list-none flex-wrap gap-1 rounded-lg bg-secondary_alt p-1 shadow-[inset_0_0_0_1px_var(--border-secondary)]">
		{
			links.map((l) => (
				<li>
					<a
						href={l.href}
						aria-current={l.id === current ? "page" : undefined}
						class="inline-flex h-9 items-center rounded-md px-3 text-sm font-semibold text-quaternary no-underline transition-colors duration-100 hover:text-secondary focus-visible:shadow-focus-ring focus-visible:outline-none aria-[current=page]:bg-primary_alt aria-[current=page]:text-secondary aria-[current=page]:shadow-[var(--shadow-sm),inset_0_0_0_1px_var(--border-primary)]"
					>
						{l.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>
