---
// Navegación entre los sets de iconos y recursos (de línea, logos, banderas, pagos, archivos y cursores): `Tabs` `underline`
// con `href`, que se pinta en el servidor como una `<nav>` de enlaces, sin JavaScript. Cada set lleva su recuento,
// calculado de los paquetes, y el actual va con `aria-current="page"`. En móvil la fila se desplaza en horizontal.
import { Tabs } from "@jotis-me/react";
import { buildEntries, countLogos, FILE_GROUP, type IconSet, setTabs } from "../lib/gallery";
import { FLAGS, ICON_NAMES } from "../lib/untitled";

interface Props {
	current: IconSet;
}
const { current } = Astro.props;

// Los mismos SVG que piden las páginas de cada set: aquí solo se cuentan
const logos = import.meta.glob<string>("../../../../packages/assets/dist/logos/*/*.svg", {
	query: "?no-inline",
	import: "default",
	eager: true,
});
const payments = import.meta.glob<string>("../../../../packages/assets/dist/payments/*.svg", {
	query: "?no-inline",
	import: "default",
	eager: true,
});
const cursors = import.meta.glob<string>("../../../../packages/assets/dist/cursors/*.svg", {
	query: "?no-inline",
	import: "default",
	eager: true,
});

const items = setTabs({
	icons: ICON_NAMES.length,
	logos: countLogos(Object.keys(logos)),
	flags: FLAGS.length,
	payments: buildEntries("payments", payments).length,
	files: Object.keys(FILE_GROUP).length,
	cursors: Object.keys(cursors).length,
});
---

<Tabs
	type="underline"
	aria-label="Tipo de icono"
	items={items}
	value={current}
	className="-mx-1 -my-1 overflow-x-auto px-1 py-1 [&>ul]:w-max [&>ul]:min-w-full"
/>
