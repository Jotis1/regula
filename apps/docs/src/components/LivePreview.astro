---
// Vista previa en vivo de un componente en su card de /components/ (design D1-D7): su muestra característica
// (thumbnails.tsx), pintada en el servidor sin directiva `client:*` (cero JavaScript) y centrada en un escenario de
// 288×180, sobre un damero sutil que indica transparencia (TransparencyGrid), como las vistas previas de Scaena. La
// muestra se pinta a su tamaño real y nunca se encoge: si no cabe en el escenario, se recorta desde su ancla (`crop`)
// con un fundido en el borde (design D2). Es decorativa: inerte, fuera del árbol de accesibilidad y del buscador. Los
// de Stream van siempre en oscuro.
import { TransparencyGrid } from "@jotis-me/react";
import { DARK_PREVIEWS } from "../visual/cards";
import { THUMBNAILS, Thumbnail } from "../visual/thumbnails";
import { CROP_ALIGN, fadeMask, PREVIEW_BOX } from "../visual/thumbs";

interface Props {
	name: string;
}

const { name } = Astro.props;
const thumbnail = THUMBNAILS[name];
const crop = thumbnail?.crop ?? "center";
const mask = fadeMask(crop);
---

<TransparencyGrid
	aria-hidden="true"
	inert
	data-pagefind-ignore
	data-live-preview={name}
	className={`pointer-events-none flex aspect-[16/10] items-center justify-center overflow-hidden p-4 shadow-[inset_0_-1px_0_var(--border-secondary)]${DARK_PREVIEWS.has(name) ? " dark-mode" : ""}`}
>
	<div
		data-thumb-stage
		class={`relative flex shrink-0 overflow-hidden ${CROP_ALIGN[crop]}`}
		style={`width:${PREVIEW_BOX.width}px;height:${PREVIEW_BOX.height}px;content-visibility:auto;contain-intrinsic-size:${PREVIEW_BOX.width}px ${PREVIEW_BOX.height}px;-webkit-mask-image:${mask};-webkit-mask-composite:source-in;mask-image:${mask};mask-composite:intersect`}
	>
		{
			thumbnail && (
				<div
					data-thumb
					class="flex shrink-0 items-center justify-center font-body text-primary antialiased"
				>
					<Thumbnail name={name} />
				</div>
			)
		}
	</div>
</TransparencyGrid>
