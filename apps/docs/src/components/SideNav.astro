---
// Navegación lateral (reference/docs-design/Main.dc.html y Menu.dc.html) con el `SidebarNav` del paquete: `simple`,
// con los submenús como <details> (`disclosure="native"`), que se pintan en el servidor y se abren y se cierran sin
// JavaScript (design D2). En el lateral lleva el árbol de la sección actual; en el menú móvil, los cinco bloques de la
// web. El filtro es el `search` del componente, que solo se ve cuando hay JavaScript: lo muestra y lo hace funcionar
// src/lib/docnav.ts.
import { Kbd, SidebarNav } from "@jotis-me/react";
import { type NavScope, sidebarTree } from "../nav";

interface Props {
	/** Ruta de la página actual. */
	current: string;
	/** Distingue esta navegación de la otra de la página (el lateral y el menú móvil): el id de sus datos del filtro. */
	idPrefix?: string;
	/** Por defecto, el árbol de la sección en el lateral y los cinco bloques en cualquier otra (el menú móvil). */
	scope?: NavScope;
}
const { current, idPrefix = "docnav", scope = idPrefix === "docnav" ? "section" : "all" } = Astro.props;
const { items, keywords } = sidebarTree(current, scope);
// `<` fuera del JSON para que nada cierre la etiqueta <script>
const keywordsJson = JSON.stringify(keywords).replaceAll("<", "\\u003c");
---

<div
	data-docnav
	data-scope={scope}
	class="[&:not([data-docnav-ready])>nav>*:has(input)]:hidden"
>
	<SidebarNav
		type="simple"
		disclosure="native"
		search
		items={items}
		labels={{ nav: "Documentación", search: "Filtrar navegación" }}
		className={scope === "section" ? "h-auto! min-h-full shadow-none!" : "h-auto! w-full! shadow-none!"}
	/>
	<p class="px-6 pb-6 text-sm text-tertiary" data-docnav-empty hidden>
		Nada se llama así. Prueba la búsqueda global con <Kbd variant="field">Ctrl K</Kbd>, que también mira tokens e iconos.
	</p>
	<script is:inline type="application/json" id={`${idPrefix}-keywords`} data-docnav-keywords set:html={keywordsJson} />
</div>

<script>
	import { initDocNav } from "../lib/docnav";

	for (const nav of document.querySelectorAll<HTMLElement>("[data-docnav]")) initDocNav(nav);
</script>
