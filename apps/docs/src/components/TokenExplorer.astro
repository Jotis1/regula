---
// Explorador de tokens de Color (design D6 de redesign-docs-site-v2), generado desde @jotis-me/tokens: un token nuevo
// aparece sin tocar la web. Filtro por nombre, valor o uso, elección de familia y, de cada token, sus dos valores a la
// vez, su utilidad para copiar y su nota de uso; en escritorio, además, el contraste WCAG de texto e iconos (calculado
// en el build). Lo pinta `TokenExplorerView` en el servidor, sin isla; el script solo esconde lo que no toca.
// Sin JavaScript se leen todas las familias seguidas y las pestañas son enlaces a cada una; el filtro no aparece.
import { colors } from "@jotis-me/tokens";
import { explorerFamilies } from "../lib/tokens";
import TokenExplorerView from "./TokenExplorerView";

const families = explorerFamilies(colors);
---

<TokenExplorerView families={families} />
<noscript>
	<style is:inline>
		[data-tokens] [data-token-family] { display: block; }
		[data-tokens] [data-tokens-js] { display: none; }
	</style>
</noscript>

<script>
	import { initTokenExplorer } from "../lib/token-explorer";

	initTokenExplorer();
</script>
