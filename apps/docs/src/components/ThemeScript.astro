---
// Aplica el tema antes de pintar: lo elegido antes (localStorage) o, la primera vez, lo que pida el sistema. Además
// deja la elección en `data-tema` de <html> («sistema», «claro» u «oscuro»): el selector de la cabecera la usa para
// enseñar desde la primera pintura el icono de lo elegido, sin esperar a que cargue su JavaScript.
---

<script is:inline>
	(() => {
		let stored = null;
		try {
			stored = localStorage.getItem("regula-tema");
		} catch {}
		const choice = stored === "oscuro" || stored === "claro" ? stored : "sistema";
		const dark = choice === "sistema" ? matchMedia("(prefers-color-scheme: dark)").matches : choice === "oscuro";
		document.documentElement.classList.toggle("dark-mode", dark);
		document.documentElement.dataset.tema = choice;
	})();
</script>
