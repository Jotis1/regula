---
// Columna derecha de las páginas de fundamentos y de componente (design D1 de redesign-docs-site-v2): «En esta
// página» como `Tabs` vertical `line` con `href` de ancla, pegada arriba al desplazarse. El servidor la pinta como una
// `<nav>` de enlaces; `initToc` (src/lib/toc.ts) mueve `aria-current="location"` al de la sección que se lee. Por
// debajo de `xl` no se pinta: en móvil el índice no se muestra. Lo demás de la columna (relacionados, «Proponer un
// cambio») entra por el contenido.
import { Tabs } from "@jotis-me/react";

interface Props {
	items: { slug: string; text: string }[];
}
const { items } = Astro.props;
---

<div data-toc class="sticky top-6 hidden w-52 shrink-0 flex-col gap-2 self-start xl:flex">
	{
		items.length > 0 && (
			<>
				<p class="text-xs font-semibold text-quaternary">En esta página</p>
				<Tabs
					orientation="vertical"
					type="line"
					aria-label="En esta página"
					items={items.map((i) => ({ id: i.slug, label: i.text, href: `#${i.slug}` }))}
				/>
			</>
		)
	}
	<slot />
</div>
