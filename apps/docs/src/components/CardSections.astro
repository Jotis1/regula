---
// La ficha de un componente repartida por etiqueta (src/lib/card.ts). La página la pone en dos sitios, como el diseño:
// `part="uso"` arriba y `part="detalles"` tras el código.
// «Cuándo usarlo» y «Evita» (design D3 de redesign-docs-site-v2, Main.dc.html): si el arranque del componente trae
// pares (`examples`), cada sección abre con sus `ExampleCard` «Esto sí» y «Esto no», con el componente real y una
// frase de la ficha por pie, y debajo el resto del texto. Sin pares, las dos tarjetas de texto de siempre.
// «Detalles y accesibilidad»: «Detalles» como pares de título y texto, «Accesibilidad» y «Amplía o difiere de la
// guía» en una tarjeta de marca.
import { ExampleCard, type IconComponent } from "@jotis-me/react";
import { CheckCircle, Stars02, XClose } from "@untitledui/icons";
import type { CardSection, Usage } from "../lib/card";
import { inline } from "../lib/inline";
import SectionTitle from "./SectionTitle.astro";
import Specimens from "./Specimens";

interface Props {
	/** El componente de la página: el que pintan los especímenes. */
	name: string;
	/** La ficha con sus pares de ejemplo (`usageOf`). */
	usage: Usage;
	part: "uso" | "detalles";
}
const { name, usage, part } = Astro.props;
const { sections } = usage.card;
const find = (id: CardSection["id"]) => sections.find((s) => s.id === id);
const cards = [
	{ section: find("uso"), icon: CheckCircle, color: "text-fg-success-primary" },
	{ section: find("evita"), icon: XClose, color: "text-fg-error-primary" },
].filter((c) => c.section) as { section: CardSection; icon: IconComponent; color: string }[];
// Con pares: una sección por parte, con sus tarjetas y lo que queda del texto
const paired = (["uso", "evita"] as const)
	.map((id) => ({
		id,
		title: id === "uso" ? "Cuándo usarlo" : "Evita",
		pairs: usage.pairs[id],
		rest: find(id)?.paragraphs ?? [],
	}))
	.filter((s) => s.pairs.length > 0 || s.rest.length > 0);
const accessibility = find("accesibilidad");
const extends_ = find("amplia");
const details = find("detalles");
const box = "rounded-xl p-4 shadow-[inset_0_0_0_1px_var(--border-secondary)] md:p-5";
---

{
	part === "uso" &&
		usage.paired &&
		paired.map((s) => (
			<section aria-labelledby={s.id} class="flex flex-col gap-5" data-card-section={s.id}>
				<SectionTitle id={s.id} title={s.title} />
				{s.pairs.map((pair) => (
					<div class="not-prose grid grid-cols-1 gap-4 md:grid-cols-2" data-example-pair>
						{(["do", "dont"] as const).map((verdict) => (
							<ExampleCard verdict={verdict} caption={pair[verdict].caption}>
								{/* El pie con su marcado (`código`): el slot manda sobre la prop, que solo cumple con el tipo */}
								<span slot="caption" set:html={inline(pair[verdict].caption)} />
								<Specimens name={name} side={pair[verdict]} />
							</ExampleCard>
						))}
					</div>
				))}
				{s.rest.length > 0 && (
					<ul class="m-0">
						{s.rest.map((p) => (
							<li set:html={inline(p.trimmed ? p.text : p.raw)} />
						))}
					</ul>
				)}
			</section>
		))
}
{
	part === "uso" && !usage.paired && cards.length > 0 && (
		<section aria-labelledby="uso" class="flex flex-col gap-5">
			<SectionTitle id="uso" title="Cuándo usarlo" />
			<div class:list={["not-prose grid grid-cols-1 gap-3 md:gap-4", cards.length > 1 && "md:grid-cols-2"]}>
				{cards.map(({ section, icon: Icon, color }) => (
					<div class={`flex flex-col gap-3 ${box}`} data-card-section={section.id}>
						<h3 class="flex items-center gap-2 text-sm font-semibold text-primary">
							<Icon size={20} className={color} />
							{section.title}
						</h3>
						{section.paragraphs.map((p) => (
							<p class="text-sm text-secondary" set:html={inline(p.raw)} />
						))}
					</div>
				))}
			</div>
		</section>
	)
}
{
	part === "detalles" && (details || accessibility || extends_) && (
		<section aria-labelledby="detalles" class="flex flex-col gap-5">
			<SectionTitle id="detalles" title="Detalles y accesibilidad" />
			{details && (
				<dl class="not-prose flex flex-col" data-card-section="detalles">
					{details.paragraphs.map((p) => (
						<div class="flex flex-col gap-0.5 py-3 shadow-[inset_0_-1px_0_var(--border-secondary)] md:grid md:grid-cols-[200px_minmax(0,1fr)] md:gap-6 md:py-3.5">
							<dt class="text-sm font-semibold text-primary" set:html={inline(p.label)} />
							<dd class="text-sm text-secondary" set:html={inline(p.text)} />
						</div>
					))}
				</dl>
			)}
			{accessibility && (
				<div class={`not-prose flex flex-col gap-3 ${box}`} data-card-section="accesibilidad">
					<h3 class="text-sm font-semibold text-primary">{accessibility.title}</h3>
					{accessibility.paragraphs.map((p) => (
						<p class="text-sm text-secondary" set:html={inline(p.raw)} />
					))}
				</div>
			)}
			{extends_ && (
				<div
					class="not-prose flex flex-col gap-3 rounded-xl p-4 shadow-[inset_0_0_0_1px_var(--border-brand)] md:p-5"
					data-card-section="amplia"
				>
					<h3 class="flex items-center gap-2 text-sm font-semibold text-primary">
						<Stars02 size={20} className="text-fg-brand-primary" />
						{extends_.title}
					</h3>
					{extends_.paragraphs.map((p) => (
						<p class="text-sm text-secondary" set:html={inline(p.raw)} />
					))}
				</div>
			)}
		</section>
	)
}
