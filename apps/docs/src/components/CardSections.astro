---
// La ficha de un componente repartida por etiqueta (src/lib/card.ts): «Úsalo así» y «Evita» en dos tarjetas
// (Button.dc.html, «Cuándo usarlo»), «Accesibilidad», «Amplía o difiere de la guía» en una tarjeta de marca y
// «Detalles» como pares de título y texto. Cada párrafo se pinta con su texto de la ficha, sin cambios.
import { Icon, type IconName } from "@jotis-me/react";
import type { CardSection, SplitCard } from "../lib/card";
import { inline } from "../lib/inline";

interface Props {
	card: SplitCard;
}
const { sections } = Astro.props.card;
const find = (id: CardSection["id"]) => sections.find((s) => s.id === id);
const cards = [
	{ section: find("uso"), icon: "check-circle", color: "text-fg-success-primary" },
	{ section: find("evita"), icon: "x-close", color: "text-fg-error-primary" },
].filter((c) => c.section) as { section: CardSection; icon: IconName; color: string }[];
const accessibility = find("accesibilidad");
const extends_ = find("amplia");
const details = find("detalles");
const box = "rounded-xl p-4 shadow-[inset_0_0_0_1px_var(--border-secondary)] md:p-5";
---

{
	cards.length > 0 && (
		<section aria-labelledby="uso">
			<h2 id="uso">Cuándo usarlo</h2>
			<div class:list={["not-prose my-4 grid grid-cols-1 gap-3 md:gap-4", cards.length > 1 && "md:grid-cols-2"]}>
				{cards.map(({ section, icon, color }) => (
					<div class={`flex flex-col gap-3 ${box}`} data-card-section={section.id}>
						<h3 class="flex items-center gap-2 text-sm font-semibold text-primary">
							<Icon name={icon} size={20} className={color} />
							{section.title}
						</h3>
						{section.paragraphs.map((p) => (
							<p class="text-sm text-secondary" set:html={inline(p.raw)} />
						))}
					</div>
				))}
			</div>
		</section>
	)
}
{
	(details || accessibility || extends_) && (
		<section aria-labelledby="detalles">
			<h2 id="detalles">Detalles y accesibilidad</h2>
			{details && (
				<dl class="not-prose my-4 flex flex-col" data-card-section="detalles">
					{details.paragraphs.map((p) => (
						<div class="flex flex-col gap-0.5 py-3 shadow-[inset_0_-1px_0_var(--border-secondary)] md:grid md:grid-cols-[200px_minmax(0,1fr)] md:gap-6 md:py-3.5">
							<dt class="text-sm font-semibold text-primary" set:html={inline(p.label)} />
							<dd class="text-sm text-secondary" set:html={inline(p.text)} />
						</div>
					))}
				</dl>
			)}
			{accessibility && (
				<div class={`not-prose my-4 flex flex-col gap-3 ${box}`} data-card-section="accesibilidad">
					<h3 class="text-sm font-semibold text-primary">{accessibility.title}</h3>
					{accessibility.paragraphs.map((p) => (
						<p class="text-sm text-secondary" set:html={inline(p.raw)} />
					))}
				</div>
			)}
			{extends_ && (
				<div
					class="not-prose my-4 flex flex-col gap-3 rounded-xl p-4 shadow-[inset_0_0_0_1px_var(--border-brand)] md:p-5"
					data-card-section="amplia"
				>
					<h3 class="flex items-center gap-2 text-sm font-semibold text-primary">
						<Icon name="stars-02" size={20} className="text-fg-brand-primary" />
						{extends_.title}
					</h3>
					{extends_.paragraphs.map((p) => (
						<p class="text-sm text-secondary" set:html={inline(p.raw)} />
					))}
				</div>
			)}
		</section>
	)
}
