---
// Las props de un componente (design D3 de redesign-docs-site-v2). Desde `lg`, la tabla, en una caja que se desplaza
// en horizontal si no cabe y recibe el foco para desplazarla con el teclado. Por debajo, una lista de `Disclosure`, uno
// por prop: el tipo bajo el nombre y, dentro, la descripción y el valor por defecto. Sin isla: `<details>` del servidor.
import { Disclosure } from "@jotis-me/react";
import type { PropRow } from "../lib/props";
import InlineCode from "./InlineCode.astro";

interface Props {
	rows: PropRow[];
	/** Nombre del componente, para el nombre accesible de la tabla y de la lista. */
	label: string;
}
const { rows, label } = Astro.props;
---

<div
	role="region"
	aria-label={`Props de ${label}`}
	tabindex="0"
	data-props-table
	class="hidden overflow-x-auto rounded-sm focus-visible:shadow-focus-ring focus-visible:outline-none lg:block"
>
	<table>
		<thead>
			<tr>
				<th>Prop</th>
				<th>Tipo</th>
				<th>Por defecto</th>
				<th>Descripción</th>
			</tr>
		</thead>
		<tbody>
			{
				rows.map((p) => (
					<tr>
						<td>
							<code>{p.name}</code>
							{p.required && <span class="ml-1 text-xs font-medium text-brand-tertiary">obligatoria</span>}
						</td>
						<td>
							<code class="whitespace-normal!">{p.type}</code>
						</td>
						<td>{p.defaultValue === undefined ? <span class="text-quaternary">—</span> : <code>{p.defaultValue}</code>}</td>
						<td><InlineCode text={p.description} /></td>
					</tr>
				))
			}
		</tbody>
	</table>
</div>

<ul
	aria-label={`Props de ${label}`}
	data-props-list
	class="not-prose m-0 flex list-none flex-col border-t border-secondary p-0 lg:hidden"
>
	{
		rows.map((p) => (
			<li data-prop={p.name}>
				{/* `title` es obligatoria en el tipo; lo que se pinta es el slot, con el tipo bajo el nombre */}
				<Disclosure title={p.name}>
					<span slot="title" class="flex min-w-0 flex-col gap-0.5 py-2.5">
						<span class="flex flex-wrap items-center gap-x-2">
							<span class="font-mono text-[13px] font-medium text-primary">{p.name}</span>
							{p.required && <span class="text-xs font-medium text-brand-tertiary">obligatoria</span>}
						</span>
						<span class="font-mono text-xs font-normal break-words text-tertiary">{p.type}</span>
					</span>
					<div class="flex flex-col gap-2">
						{p.description && (
							<p class="m-0 text-sm text-tertiary [&_code]:font-mono [&_code]:text-[13px] [&_code]:text-secondary">
								<InlineCode text={p.description} />
							</p>
						)}
						<p class="m-0 text-sm text-tertiary">
							<span class="font-medium text-secondary">Por defecto:</span>{" "}
							{p.defaultValue === undefined ? "sin valor" : <code class="font-mono text-[13px] text-secondary">{p.defaultValue}</code>}
						</p>
					</div>
				</Disclosure>
			</li>
		))
	}
</ul>
