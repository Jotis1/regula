---
// Excepciones de contraste de la guía (reference/GUIA.md, «Contraste»): los datos y el cálculo viven en
// lib/contrast-exceptions.ts, que comparte con el README del artefacto generado.
import { CONTRAST_EXCEPTIONS, type ContrastException, exceptionRatio } from "../lib/contrast-exceptions";
import { inline } from "../lib/inline";

// Una variable del frontmatter: así Biome ve que el import se usa (no lo pasa a `type`)
const exceptions = CONTRAST_EXCEPTIONS;
const value = (e: ContrastException, theme: "light" | "dark") => exceptionRatio(e, theme);
const cell = "px-5 py-3.5";
---

<!-- En móvil la tabla se desplaza dentro de su caja; con teclado, la caja recibe el foco para desplazarla -->
<div
	role="region"
	aria-label="Excepciones de contraste"
	tabindex="0"
	class="not-prose my-4 overflow-x-auto rounded-xl shadow-[inset_0_0_0_1px_var(--border-secondary)] focus-visible:shadow-focus-ring focus-visible:outline-none"
>
	<table class="w-full min-w-[560px] border-collapse text-sm">
		<caption class="sr-only">Tokens por debajo del contraste recomendado y cómo usarlos</caption>
		<thead>
			<tr class="bg-secondary">
				<th scope="col" class="px-5 py-3 text-left text-xs font-medium text-tertiary">Token</th>
				<th scope="col" class="px-5 py-3 text-right text-xs font-medium text-tertiary">Claro</th>
				<th scope="col" class="px-5 py-3 text-right text-xs font-medium text-tertiary">Oscuro</th>
				<th scope="col" class="px-5 py-3 text-left text-xs font-medium text-tertiary">Cómo se usa</th>
			</tr>
		</thead>
		<tbody>
			{
				exceptions.map((e) => (
					<tr class="shadow-[inset_0_1px_0_var(--border-secondary)]">
						<th scope="row" class={`${cell} text-left font-mono text-[13px] font-medium whitespace-nowrap text-primary`}>
							{e.name}
							{e.on === "white" && <span class="block font-body text-xs font-normal text-quaternary">con texto blanco</span>}
						</th>
						<td class={`${cell} text-right whitespace-nowrap text-secondary tabular-nums`}>{value(e, "light")}</td>
						<td class={`${cell} text-right whitespace-nowrap text-secondary tabular-nums`}>{value(e, "dark")}</td>
						<td class={`${cell} text-tertiary`} set:html={inline(e.how)} />
					</tr>
				))
			}
		</tbody>
	</table>
</div>
