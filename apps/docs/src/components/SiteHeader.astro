---
// Cabecera de la web: en escritorio, reference/docs-design/Header.dc.html (icono de Regula y nombre, las cinco
// secciones con la actual marcada, búsqueda con aspecto de campo y conmutador de tema); por debajo de lg,
// HeaderM.dc.html (icono y nombre, botones de búsqueda y tema, y el menú a pantalla completa). El icono va en la
// variante Claro en el tema claro, como pide la guía dentro de una interfaz clara, y en la principal en el oscuro
// (design §9).
import { AppIcon } from "@jotis-me/react";
import { SECTIONS, sectionOf } from "../lib/catalog";
import SiteSearch from "../search/SiteSearch";
import MobileMenu from "./MobileMenu";
import SideNav from "./SideNav.astro";
import ThemeToggle from "./ThemeToggle.astro";

const current = sectionOf(Astro.url.pathname);
---

<header
	class="relative flex h-14 items-center gap-1 bg-primary pr-1.5 pl-4 shadow-[inset_0_-1px_0_var(--border-secondary)] lg:h-16 lg:gap-8 lg:px-8"
>
	<a
		href="#contenido"
		class="absolute -top-24 left-4 z-60 rounded-lg bg-primary_alt px-3 py-2 text-sm font-semibold text-primary shadow-lg focus:top-3 focus-visible:outline-none"
	>
		Saltar al contenido
	</a>
	<a
		href="/"
		aria-label="Regula, portada"
		class="flex min-h-11 shrink-0 items-center gap-2 rounded-md text-primary focus-visible:shadow-focus-ring focus-visible:outline-none lg:gap-2.5"
	>
		<span aria-hidden="true" class="flex lg:hidden dark:hidden"><AppIcon app="regula" variant="light" size={24} tilde /></span>
		<span aria-hidden="true" class="hidden dark:flex lg:dark:hidden"><AppIcon app="regula" size={24} tilde /></span>
		<span aria-hidden="true" class="hidden lg:flex lg:dark:hidden"><AppIcon app="regula" variant="light" size={28} tilde /></span>
		<span aria-hidden="true" class="hidden lg:dark:flex"><AppIcon app="regula" size={28} tilde /></span>
		<span class="font-display text-lg font-bold tracking-[-0.02em] lg:text-xl">Regula</span>
	</a>
	<nav aria-label="Secciones" class="hidden h-16 items-center gap-6 lg:flex">
		{
			SECTIONS.map((s) => (
				<a
					href={s.href}
					aria-current={current === s.id ? "true" : undefined}
					class="inline-flex h-16 items-center px-0.5 text-sm font-semibold text-tertiary transition-colors duration-100 hover:text-primary focus-visible:rounded-md focus-visible:shadow-focus-ring focus-visible:outline-none aria-[current]:text-primary aria-[current]:shadow-[inset_0_-2px_0_var(--fg-brand-primary_alt)]"
				>
					{s.label}
				</a>
			))
		}
	</nav>
	<div class="ml-auto flex items-center gap-1 lg:gap-8">
		<SiteSearch client:idle />
		<ThemeToggle />
		<div class="flex lg:hidden">
			<MobileMenu client:media="(max-width: 1023.98px)">
				<SideNav current={Astro.url.pathname} idPrefix="menu" />
			</MobileMenu>
		</div>
	</div>
</header>
