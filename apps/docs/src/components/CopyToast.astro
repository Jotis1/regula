---
// Copia al portapapeles lo que lleve `data-copy` y lo confirma con un aviso breve.
---

<div
	id="copy-toast"
	role="status"
	aria-live="polite"
	class="pointer-events-none fixed right-6 bottom-6 z-50 rounded-lg bg-primary-solid px-3 py-2 text-sm font-medium text-white opacity-0 shadow-lg transition-opacity duration-150"
>
</div>

<script>
	const toast = document.getElementById("copy-toast") as HTMLElement;
	let timer: ReturnType<typeof setTimeout> | undefined;
	document.addEventListener("click", async (event) => {
		const target = (event.target as Element).closest<HTMLElement>("[data-copy]");
		if (!target) return;
		const value = target.dataset.copy ?? "";
		try {
			await navigator.clipboard.writeText(value);
			toast.textContent = `Copiado: ${value}`;
		} catch {
			toast.textContent = "No se pudo copiar. Selecciónalo a mano.";
		}
		toast.classList.remove("opacity-0");
		clearTimeout(timer);
		timer = setTimeout(() => toast.classList.add("opacity-0"), 1800);
	});
</script>
