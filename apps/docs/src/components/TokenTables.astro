---
// Tablas de tokens que cierran las páginas de tipografía, espaciado y estados, generadas desde @jotis-me/tokens. Desde
// `md` cada sección es una tabla; por debajo, una tarjeta por token (nombre que se copia, muestra, valor y uso), sin
// tabla que se desplace a lo ancho, como el explorador de Color. La copia la hace el `CopyTooltip` de la página
// (`data-copy`).
import { blur, radius, shadows, spacing, type, width } from "@jotis-me/tokens";
import { radiusRows, shadowRows, spacingRows, tokenSections } from "../lib/tokens";
import MdxH2 from "./MdxH2.astro";

interface Props {
	page: string;
}
const { page } = Astro.props;
// Las anclas de sus títulos, las mismas que pone la página en su índice
const ids = new Map(tokenSections(page, type.groups).map((s) => [s.text, s.slug]));

const typeUtility = (family: string, style: string) => {
	const size = style.replace(/-(regular|medium|semibold|bold)$/, "").replace(/^text-/, "");
	const weight = style.match(/-(regular|medium|semibold|bold)$/)?.[1];
	const w = weight === "regular" ? "font-normal" : weight ? `font-${weight}` : "";
	return [`text-${size}`, w, family === "body" ? "" : `font-${family}`].filter(Boolean).join(" ");
};

// La muestra se pinta con los valores del token y no con la clase: la clase se monta aquí en tiempo de
// ejecución y Tailwind no la ve al escanear, así que solo existiría si otro módulo la usa (en dev, además,
// solo los ya cargados). Así un estilo nuevo aparece bien sin tocar la web.
const typeStyle = (family: string, s: (typeof type.groups)[number]["styles"][number]) =>
	[
		`font-family:${type.families[family as keyof typeof type.families]}`,
		`font-size:${s.fontSize}`,
		`line-height:${s.lineHeight}`,
		`font-weight:${s.fontWeight}`,
		"letterSpacing" in s && s.letterSpacing ? `letter-spacing:${s.letterSpacing}` : "",
	]
		.filter(Boolean)
		.join(";");

interface Row {
	/** Lo que se lee en el botón. */
	name: string;
	/** Lo que se copia al pulsarlo. */
	copy: string;
	/** La utilidad, junto al nombre, cuando el botón copia otra cosa o no la enseña. */
	hint?: string;
	/** Una frase pintada con el estilo del token, bajo el nombre (tipografía). */
	text?: string;
	/** La muestra de la segunda columna: su clase (`spacer`, `radius-sample`, `shadow-sample`) y su estilo. */
	sample?: { class: string; style: string };
	value?: string;
	usage: string;
}
interface Section {
	title: string;
	head: [string, string, string];
	rows: Row[];
}

const sections: Section[] =
	page === "typography"
		? type.groups.map((group) => ({
				title: group.name,
				head: ["Estilo", "Tamaño", "Uso"],
				rows: group.styles.map((s) => ({
					name: s.name,
					copy: typeUtility(group.family, s.name),
					text: typeStyle(group.family, s),
					value: `${s.fontSize}/${s.lineHeight}`,
					usage: s.usage ?? "",
				})),
			}))
		: page === "layout"
			? [
					{
						title: "Escala de espaciado",
						head: ["Token", "Valor", "Uso"],
						rows: spacingRows(spacing).map((row) => ({
							name: row.name,
							copy: row.utility ?? `var(--${row.name})`,
							hint: row.utility,
							sample: { class: "spacer", style: `width:${row.value}` },
							value: row.value,
							usage: row.usage,
						})),
					},
					{
						title: "Radios",
						head: ["Utilidad", "Valor", "Uso"],
						rows: radiusRows(radius).map((row) => ({
							name: row.utility ?? row.name,
							copy: row.utility ?? row.name,
							sample: { class: "radius-sample", style: `border-radius:${row.value}` },
							value: row.value,
							usage: row.usage,
						})),
					},
					{
						title: "Anchos",
						head: ["Token", "Valor", "Uso"],
						rows: Object.entries(width).map(([name, t]) => ({
							name,
							copy: `var(--${name})`,
							value: t.value,
							usage: t.usage,
						})),
					},
				]
			: page === "states"
				? [
						{
							title: "Sombras",
							head: ["Utilidad", "Muestra", "Uso"],
							rows: shadowRows(shadows).map((row) => ({
								name: row.utility,
								copy: row.utility,
								sample: { class: "shadow-sample", style: `box-shadow:var(--${row.name})` },
								usage: row.usage,
							})),
						},
						{
							title: "Desenfoques",
							head: ["Utilidad", "Valor", "Uso"],
							rows: Object.entries(blur).map(([name, t]) => ({
								name,
								copy: name,
								value: t.value,
								usage: t.usage,
							})),
						},
					]
				: [];
---

{
	sections.map((section) => (
		<section>
			<MdxH2 id={ids.get(section.title)}>{section.title}</MdxH2>
			<div class="max-md:hidden">
				<table>
					<thead>
						<tr>
							{section.head.map((h) => (
								<th>{h}</th>
							))}
						</tr>
					</thead>
					<tbody>
						{section.rows.map((row) => (
							<tr>
								<td>
									<button
										type="button"
										class="token-copy"
										data-copy={row.copy}
										aria-label={`Copiar ${row.name}`}
										title={row.copy === row.name ? undefined : row.copy}
									>
										{row.name}
									</button>
									{row.hint && <span class="ml-2 text-xs text-quaternary">{row.hint}</span>}
									{row.text && (
										<p class="mt-2 text-primary" style={row.text}>
											Gasto de octubre
										</p>
									)}
								</td>
								<td>
									{row.sample && <span class={row.sample.class} style={row.sample.style} />}
									{row.value && <code>{row.value}</code>}
								</td>
								<td>{row.usage}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<ul class="not-prose m-0 flex list-none flex-col gap-3 p-0 md:hidden" data-token-cards>
				{section.rows.map((row) => (
					<li class="flex min-w-0 flex-col items-start gap-3 rounded-xl border border-secondary bg-primary p-4">
						<div class="flex max-w-full flex-wrap items-center gap-x-3 gap-y-1">
							<button
								type="button"
								class="token-copy whitespace-normal break-all"
								data-copy={row.copy}
								aria-label={`Copiar ${row.name}`}
							>
								{row.name}
							</button>
							{row.value && <code class="font-mono text-xs text-tertiary">{row.value}</code>}
							{row.hint && <span class="text-xs text-quaternary">{row.hint}</span>}
						</div>
						{row.text && (
							<p class="max-w-full break-words text-primary" style={row.text}>
								Gasto de octubre
							</p>
						)}
						{row.sample && (
							<span class:list={[row.sample.class, "mr-0 max-w-full"]} style={row.sample.style} />
						)}
						{row.usage && <p class="text-sm text-tertiary">{row.usage}</p>}
					</li>
				))}
			</ul>
		</section>
	))
}
