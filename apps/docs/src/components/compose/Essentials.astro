---
// Tarjetas de «lo esencial» (Color.dc.html y Tone.dc.html): título, texto de la guía y, si hace falta, unas muestras.
// Con una sola tarjeta sirve de nota destacada (la de «La voz» en Contenido y tono).
import { FeaturedIcon, type IconName } from "@jotis-me/react";
import { inline } from "../../lib/inline";

interface Props {
	items: {
		title: string;
		text: string;
		/** Clases de utilidad de cada muestra (p. ej. `bg-brand-solid`). */
		swatches?: string[];
	}[];
	/** Icono destacado para una nota de una sola tarjeta. */
	icon?: IconName;
}
const { items, icon } = Astro.props;
---

<div class:list={["not-prose my-4 grid grid-cols-1 gap-3 md:gap-4", items.length > 1 && "md:grid-cols-2 xl:grid-cols-3"]}>
	{
		items.map((i) => (
			<div
				class:list={[
					"flex gap-4 rounded-xl p-4 md:p-5",
					icon ? "bg-secondary shadow-[inset_0_0_0_1px_var(--border-secondary)]" : "flex-col gap-3 shadow-[inset_0_0_0_1px_var(--border-secondary)]",
				]}
			>
				{icon && <FeaturedIcon icon={icon} color="gray" variant="modern" size="md" className="hidden md:flex" />}
				{i.swatches && (
					<div aria-hidden="true" class="flex gap-1.5">
						{i.swatches.map((s) => (
							<span class={`size-7 rounded-md shadow-[inset_0_0_0_1px_var(--border-primary)] ${s}`} />
						))}
					</div>
				)}
				<div class="flex flex-col gap-1">
					<h3 class="text-md font-semibold text-primary">{i.title}</h3>
					<p class="text-sm text-tertiary" set:html={inline(i.text)} />
				</div>
			</div>
		))
	}
</div>
