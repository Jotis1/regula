---
// Un par de tarjetas de ejemplo (design D6 de redesign-docs-site-v2): «Esto sí» y «Esto no», o «En lugar de» y
// «Mejor», una al lado de la otra y apiladas en móvil. Dentro van dos `Rule`. Con `title`, el caso que enseña el par
// («Estado vacío»), como en «En lugar de esto, esto otro» de Contenido y tono (Content.dc.html).
interface Props {
	title?: string;
}
const { title } = Astro.props;
---

<div class="not-prose my-4 flex flex-col gap-3" data-example-pair={title ?? ""}>
	{title && <h3 class="text-sm font-semibold text-primary">{title}</h3>}
	<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
		<slot />
	</div>
</div>
