---
// Pares de título y texto (las reglas de escritura de Tone.dc.html): el título a la izquierda en escritorio, encima en
// móvil.
import { inline } from "../../lib/inline";

interface Props {
	items: { term: string; text: string }[];
}
const { items } = Astro.props;
---

<dl class="not-prose my-4 flex flex-col">
	{
		items.map((i) => (
			<div class="flex flex-col gap-0.5 py-3 shadow-[inset_0_-1px_0_var(--border-secondary)] md:grid md:grid-cols-[200px_minmax(0,1fr)] md:gap-6 md:py-3.5">
				<dt class="text-sm font-semibold text-primary">{i.term}</dt>
				<dd class="text-sm text-secondary" set:html={inline(i.text)} />
			</div>
		))
	}
</dl>
