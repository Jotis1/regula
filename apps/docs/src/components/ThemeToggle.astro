---
import moon from "@jotis-me/icons/svg/moon-01.svg?raw";
import sun from "@jotis-me/icons/svg/sun.svg?raw";
---

<button
	type="button"
	data-theme-toggle
	aria-label="Cambiar a modo oscuro"
	class="inline-flex size-10 items-center justify-center rounded-lg text-fg-quaternary transition-colors duration-100 hover:bg-primary_hover hover:text-fg-quaternary_hover focus-visible:shadow-focus-ring focus-visible:outline-none"
>
	<span class="contents dark:hidden" set:html={moon} />
	<span class="hidden dark:contents" set:html={sun} />
</button>

<script>
	const label = () =>
		document.documentElement.classList.contains("dark-mode") ? "Cambiar a modo claro" : "Cambiar a modo oscuro";
	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
		button.setAttribute("aria-label", label());
		button.addEventListener("click", () => {
			const dark = document.documentElement.classList.toggle("dark-mode");
			try {
				localStorage.setItem("regula-tema", dark ? "oscuro" : "claro");
			} catch {}
			button.setAttribute("aria-label", label());
		});
	}
</script>
