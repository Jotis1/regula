---
// Conmutador de la cabecera: alterna claro y oscuro y recuerda la elección. "Sistema" está en el menú móvil.
import moon from "@jotis-me/icons/svg/moon-01.svg?raw";
import sun from "@jotis-me/icons/svg/sun.svg?raw";
---

<button
	type="button"
	data-theme-toggle
	aria-label="Usar tema oscuro"
	class="inline-flex size-11 items-center justify-center rounded-lg text-fg-quaternary transition-colors duration-100 hover:bg-primary_hover hover:text-fg-quaternary_hover focus-visible:shadow-focus-ring focus-visible:outline-none lg:size-10"
>
	<span class="contents dark:hidden" set:html={moon} />
	<span class="hidden dark:contents" set:html={sun} />
</button>

<script>
	import { followSystem, isDark, onThemeChange, setTheme } from "../lib/theme";

	followSystem();
	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
		const label = () => button.setAttribute("aria-label", isDark() ? "Usar tema claro" : "Usar tema oscuro");
		label();
		onThemeChange(label);
		button.addEventListener("click", () => setTheme(isDark() ? "claro" : "oscuro"));
	}
</script>
