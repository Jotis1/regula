---
// Pie de la web montado con el `Footer` del paquete (design D5 de docs-site-with-own-components), con los datos reales: la versión de cada paquete sale de su
// package.json, en lugar de los nombres de paquete y la fecha de tokens inventados del diseño (proposal, «Datos
// reales»). El icono de Regula sigue la regla de la cabecera: Claro en el tema claro y principal en el oscuro.
import icons from "@jotis-me/icons/package.json";
import { AppIcon, Footer } from "@jotis-me/react";
import react from "@jotis-me/react/package.json";
import tokens from "@jotis-me/tokens/package.json";

const docs = [
	{ label: "Instalación", href: "/start/install/" },
	{ label: "Fundamentos", href: "/foundations/principles/" },
	{ label: "Componentes", href: "/components/" },
	{ label: "Iconos", href: "/icons/" },
];
const suite = [
	{ label: "Vinculum", href: "https://vinculum.jotis.me" },
	{ label: "Pecunia", href: "https://pecunia.jotis.me" },
	{ label: "Emptor", href: "https://emptor.jotis.me" },
	{ label: "Ornatus", href: "https://ornatus.jotis.me" },
	{ label: "Scaena", href: "https://scaena.jotis.me" },
];
const versions = [
	{ label: "Componentes", pkg: react },
	{ label: "Tokens", pkg: tokens },
	{ label: "Iconos", pkg: icons },
];
const columns = [
	{ title: "Documentación", links: docs },
	{ title: "La suite", links: suite },
];
---

<Footer
	type="large-04"
	columns={columns}
	legal={[{ label: "Qué ha cambiado", href: "/changelog/" }]}
	className="bg-secondary"
>
	<div slot="brand" class="flex items-center gap-2.5">
		<span aria-hidden="true" class="flex dark:hidden"><AppIcon app="regula" variant="light" size={24} /></span>
		<span aria-hidden="true" class="hidden dark:flex"><AppIcon app="regula" size={24} /></span>
		<span class="font-display text-lg font-bold tracking-[-0.02em] text-primary">Regula</span>
	</div>
	<Fragment slot="description">
		Las reglas de la suite jotis.me, con su código al lado. Esta web está hecha con ellas, así que si algo chirría
		aquí, chirría en todas partes.
	</Fragment>
	<span slot="copyright" data-versions>
		{
			versions.map((v, i) => (
				<>
					{i > 0 && <span aria-hidden="true" class="mx-2">·</span>}
					{v.label} <span class="font-mono">{v.pkg.name} {v.pkg.version}</span>
				</>
			))
		}
	</span>
</Footer>
