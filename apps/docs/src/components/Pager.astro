---
// Anterior y siguiente al final de las páginas de fundamentos y de componente: tarjetas con la flecha hacia donde
// llevan (el diseño no las trae; decisión del usuario, 3 nov).
import { Icon } from "@jotis-me/react";
import { PAGER } from "../lib/toc";

interface Link {
	href: string;
	label: string;
}
interface Props {
	prev?: Link;
	next?: Link;
}
const { prev, next } = Astro.props;
---

{
	(prev || next) && (
		<nav aria-label="Anterior y siguiente" class="not-prose mt-14 flex flex-col gap-3 md:flex-row md:flex-wrap md:gap-4">
			{prev && (
				<a href={prev.href} class={PAGER} rel="prev">
					<span class="flex items-center gap-1.5 text-xs text-tertiary">
						<Icon name="arrow-left" size={16} className="text-fg-quaternary" />
						Anterior
					</span>
					<span class="text-md font-semibold">{prev.label}</span>
				</a>
			)}
			{next && (
				<a href={next.href} class={`${PAGER} items-end text-right`} rel="next">
					<span class="flex items-center gap-1.5 text-xs text-tertiary">
						Siguiente
						<Icon name="arrow-right" size={16} className="text-fg-quaternary" />
					</span>
					<span class="text-md font-semibold">{next.label}</span>
				</a>
			)}
		</nav>
	)
}
