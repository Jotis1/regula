---
// Composiciones de un componente (design D7): cada tipo del Figma montado solo con componentes de Regula, con su
// ejemplo en vivo y su código copiable. No son componentes del paquete: se copian y se adaptan.
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { Breadcrumbs } from "@jotis-me/react";
import CodeSnippet from "../../../components/CodeSnippetIsland";
import Base from "../../../layouts/Base.astro";
import { groupOf, labelOf, SECTIONS, slugOf } from "../../../lib/catalog";
import { compositionCode } from "../../../lib/composition-code";
import { COMPOSITION_FILES, COMPOSITIONS, compositionsOf } from "../../../visual/compositions";
import VisualExample from "../../../visual/VisualExample";

export function getStaticPaths() {
	return [...new Set(COMPOSITIONS.map((c) => c.of))].map((name) => ({
		params: { slug: slugOf(name) },
		props: { name },
	}));
}

const { name } = Astro.props;
const label = labelOf(name);
const list = compositionsOf(name);
// El build corre en apps/docs: el código sale del fichero de ejemplos
const source = readFileSync(
	join(process.cwd(), "src/visual/examples", `${COMPOSITION_FILES[name]}.tsx`),
	"utf8",
);
const group = groupOf(name);
const section = SECTIONS.find((s) => s.id === (group?.section ?? "components"));
const crumbs = [
	...(section ? [{ label: section.label, href: section.href }] : []),
	{ label, href: `/components/${slugOf(name)}/` },
	{ label: "Composiciones" },
];
const title = `Composiciones de ${label}`;
---

<Base title={title} description={`Los ${list.length} tipos del Figma de ${label}, hechos con componentes de Regula y listos para copiar.`}>
	<article class="prose min-w-0 max-w-none">
		<header class="not-prose mb-10 flex flex-col gap-3.5">
			<Breadcrumbs items={crumbs} />
			<h1 class="font-display text-display-sm font-semibold tracking-[-0.02em] text-primary lg:text-display-md">{title}</h1>
			<p class="max-w-[680px] text-md text-tertiary lg:text-lg">
				Los {list.length} tipos del Figma de {label}, hechos solo con componentes de <code>@jotis-me/react</code>. No se
				exportan del paquete: copia el código y cámbialo a tu gusto. Aquí se pintan dentro de su caja; en tu app,
				ábrelos con <code>open</code> y ciérralos con <code>onClose</code>.
			</p>
			<nav aria-label="Composiciones" class="mt-1 flex flex-wrap gap-x-4 gap-y-1.5 text-sm">
				{list.map((c) => <a href={`#${slugOf(c.name)}`} class="text-tertiary hover:text-secondary">{c.title}</a>)}
			</nav>
		</header>

		{
			list.map((c) => (
				<section aria-labelledby={slugOf(c.name)} data-composition={c.name}>
					<h2 id={slugOf(c.name)}>{c.title}</h2>
					<p class="text-sm text-tertiary">
						Tipo del Figma: <span class="font-mono text-secondary">{c.figma}</span>
					</p>
					<div
						data-pagefind-ignore
						role="region"
						aria-label={`Composición ${c.title}`}
						tabindex="0"
						class="not-prose my-4 overflow-x-auto rounded-xl p-4 shadow-[inset_0_0_0_1px_var(--border-secondary)] focus-visible:shadow-focus-ring focus-visible:outline-none"
					>
						<div class="min-w-[640px]">
							<VisualExample client:visible name={c.name} />
						</div>
					</div>
					<div class="not-prose my-4" data-code-tabs>
						<CodeSnippet client:visible language="tsx" code={compositionCode(source, c.name)} />
					</div>
				</section>
			))
		}
	</article>
</Base>
