---
// Índice de componentes (design §10): los grupos del catálogo en su orden, cada componente en una card con su vista
// previa, su descripción de la ficha y el enlace a su página. Los cuatro grupos de Stream van al final, bajo su sección.
//
// La vista previa es la muestra del componente pintada en vivo en el servidor (LivePreview.astro, change
// live-component-previews); ya no son fotos de las capturas aprobadas.
import { getCollection } from "astro:content";
import { Breadcrumbs } from "@jotis-me/react";
import InlineCode from "../../components/InlineCode.astro";
import LivePreview from "../../components/LivePreview.astro";
import Base from "../../layouts/Base.astro";
import { COMPONENT_GROUPS, slugOf } from "../../lib/catalog";

const pages = await getCollection("components");
const descriptions = new Map(pages.map((p) => [p.data.name, p.data.description]));
const sections = [
	{
		id: "components",
		title: "Componentes de aplicación",
		groups: COMPONENT_GROUPS.filter((g) => g.section === "components"),
	},
	{ id: "stream", title: "Stream", groups: COMPONENT_GROUPS.filter((g) => g.section === "stream") },
] as const;
const total = pages.length;
const streamCount = sections[1].groups.reduce((n, g) => n + g.components.length, 0);
---

<Base
	title="Componentes"
	description={`Los ${total} componentes de @jotis-me/react, agrupados por tipo, con su descripción.`}
>
	<article class="prose max-w-none">
		<header class="not-prose mb-10 flex flex-col gap-3 lg:gap-4">
			<Breadcrumbs items={[{ label: "Componentes" }]} />
			<h1 class="font-display text-display-sm font-semibold tracking-[-0.02em] text-primary lg:text-display-md">Componentes</h1>
			<p class="max-w-[720px] text-md text-tertiary lg:text-lg">
				Los {total} componentes de <code class="font-mono">@jotis-me/react</code>, en los grupos de la navegación: {total -
					streamCount} de aplicación y {streamCount} de Stream, que van siempre en oscuro.
			</p>
		</header>
		{
			sections.map((section) => (
				<section aria-labelledby={`seccion-${section.id}`} class="not-prose mb-14">
					<h2 id={`seccion-${section.id}`} class="mb-6 font-display text-display-xs font-semibold text-primary">
						{section.title}
					</h2>
					{section.groups.map((group) => (
						<section aria-labelledby={group.id} class="mb-10">
							<h3 id={group.id} class="mb-3 flex items-baseline gap-2 text-lg font-semibold text-primary">
								{group.label}
								<span class="text-sm font-normal text-tertiary">{group.components.length}</span>
							</h3>
							<ul class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3" data-group={group.id}>
								{group.components.map((name) => (
									<li class="group relative flex flex-col overflow-hidden rounded-xl border border-secondary text-primary transition-shadow duration-100 has-[a:hover]:border-primary has-[a:hover]:shadow-sm has-[a:focus-visible]:shadow-focus-ring">
										{/* La vista previa va fuera del enlace (HTML válido y sin nada interactivo dentro de él): el enlace cubre toda la card con su ::after */}
										<LivePreview name={name} />
										<a
											href={`/components/${slugOf(name)}/`}
											class="flex flex-1 flex-col gap-0.5 p-4 text-primary no-underline outline-none after:absolute after:inset-0 after:content-['']"
										>
											<span class="text-md font-semibold group-hover:underline">{name}</span>
											<span class="text-sm text-tertiary">
												<InlineCode text={descriptions.get(name) ?? ""} />
											</span>
										</a>
									</li>
								))}
							</ul>
						</section>
					))}
				</section>
			))
		}
	</article>
</Base>
