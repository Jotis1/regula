---
import { getCollection } from "astro:content";
import { join } from "node:path";
import ComponentPage from "../../layouts/ComponentPage.astro";
import { splitCard } from "../../lib/card";
import { playgroundOf } from "../../lib/playground";
import { propsOf } from "../../lib/props";
import { snippetsOf } from "../../lib/snippets";
import { DARK_PREVIEWS } from "../../visual/registry";

export async function getStaticPaths() {
	const pages = await getCollection("components");
	return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { name, description, interactive, astroNote, source: own } = page.data;
const { next, astro } = snippetsOf(name, interactive);
// La ficha de la guía, repartida por etiqueta sin cambiar su texto (design §3)
const card = splitCard(page.body ?? "");
// El build corre en apps/docs: las props salen del fuente del componente
const source = join(process.cwd(), "../..", own ?? `packages/react/src/components/${name}.tsx`);
const rows = propsOf(source, name);
// Sobre fondo oscuro, como sus vistas previas de la guía (los de Stream)
const dark = DARK_PREVIEWS.has(name);
const playground = playgroundOf(name, rows, { interactive, dark });
// La descripción de cada componente, para las tarjetas de relacionados
const descriptions = Object.fromEntries(
	(await getCollection("components")).map((p) => [p.data.name, p.data.description]),
);
---

<ComponentPage
	name={name}
	description={description}
	card={card}
	props={rows}
	next={next}
	astro={astro}
	interactive={interactive}
	astroNote={astroNote}
	playground={playground}
	descriptions={descriptions}
/>
