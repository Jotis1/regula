---
import { getCollection } from "astro:content";
import { join } from "node:path";
import CardSections from "../../components/CardSections.astro";
import InlineCode from "../../components/InlineCode.astro";
import ComponentPage from "../../layouts/ComponentPage.astro";
import { splitCard } from "../../lib/card";
import { inline } from "../../lib/inline";
import { propsOf } from "../../lib/props";
import { snippetsOf } from "../../lib/snippets";
import { DARK_PREVIEWS } from "../../visual/registry";
import VisualExample from "../../visual/VisualExample";

export async function getStaticPaths() {
	const pages = await getCollection("components");
	return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { name, description, interactive, astroNote, source: own } = page.data;
const { next, astro } = snippetsOf(name, interactive);
// La ficha de la guía, repartida por etiqueta sin cambiar su texto (design §3)
const card = splitCard(page.body ?? "");
// El build corre en apps/docs: las props salen del fuente del componente
const source = join(process.cwd(), "../..", own ?? `packages/react/src/components/${name}.tsx`);
---

<ComponentPage name={name} description={description} props={propsOf(source, name)} next={next} astro={astro} dark={DARK_PREVIEWS.has(name)}>
	<CardSections slot="guide" card={card} />
	{card.props && <p slot="props-summary" class="text-sm" set:html={inline(card.props.raw)} />}
	<VisualExample slot="examples" client:visible name={name} />
	{astroNote && <p slot="astro-note"><InlineCode text={astroNote} /></p>}
</ComponentPage>
