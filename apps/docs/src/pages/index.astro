---
// Portada (design D4 de redesign-docs-site-v2; lienzo Home, HomeDark y HomeMobile). Las cifras se cuentan en el build
// desde los paquetes y el catálogo; la instalación sale del README de @jotis-me/react; las cinco reglas, de la guía.
// Sin cabecera de página ni lateral: lleva su propio titular. Las piezas con estado son islas de `components/home/`.
import { getCollection } from "astro:content";
import {
	AppIcon,
	appIcons,
	BackgroundPattern,
	Button,
	type IconComponent,
	Input,
	Kbd,
	LinkCard,
	SectionHeader,
	TransparencyGrid,
} from "@jotis-me/react";
import { colors } from "@jotis-me/tokens";
import { ArrowRight, BarChart01, Bell01, Calendar, Lock01, SearchLg, Send01, Zap } from "@untitledui/icons";
import readme from "../../../../packages/react/README.md?raw";
import CodeSnippet from "../components/CodeSnippetIsland";
import HeroForm from "../components/HeroForm";
import RulesStory from "../components/home/RulesStory";
import RulesStrip from "../components/home/RulesStrip";
import { thousands } from "../components/home/story";
import ThemeCompare from "../components/home/ThemeCompare";
import SectionTitle from "../components/SectionTitle.astro";
import ShowcaseImage from "../components/ShowcaseImage.astro";
import Base from "../layouts/Base.astro";
import { COMPONENT_GROUPS, FOUNDATIONS } from "../lib/catalog";
import { installTabs } from "../lib/readme";
import { ICON_NAMES } from "../lib/untitled";

const components = (await getCollection("components")).length;
const appGroups = COMPONENT_GROUPS.filter((g) => g.section === "components");
const streamGroups = COMPONENT_GROUPS.filter((g) => g.section === "stream");
const appComponents = appGroups.reduce((n, g) => n + g.components.length, 0);
const streamComponents = components - appComponents;
const icons = thousands(ICON_NAMES.length);
const colorTokens = Object.keys(colors).length;
// En la primera pantalla va solo el comando de cada framework; la hoja de estilos y el resto, en la guía
const install = installTabs(readme).map((t) => ({ label: t.label, code: t.code.split("\n\n")[0] ?? t.code }));

const previewIcons: IconComponent[] = [SearchLg, Calendar, Bell01, Lock01, BarChart01, Send01, Zap];
const swatches = ["bg-brand-solid", "bg-primary-solid", "bg-tertiary", "bg-success-solid", "bg-error-solid"];
const apps = [
	{ app: "ornatus", what: "Lector de Markdown" },
	{ app: "vinculum", what: "Acortador de enlaces" },
	{ app: "pecunia", what: "Finanzas" },
	{ app: "emptor", what: "Compras con IA" },
	{ app: "regula", what: "Esta web" },
	{ app: "scaena", what: "El escenario del canal" },
] as const;

const map = [
	{
		title: "Fundamentos",
		href: "/foundations/principles/",
		text: "Principios, tono, color, tipografía y el resto de la guía, con sus tokens.",
		meta: `${FOUNDATIONS.length} apartados y ${colorTokens} tokens de color.`,
	},
	{
		title: "Componentes",
		href: "/components/",
		text: "Botones, formularios, navegación, capas, avisos, datos, gráficas y maquetas.",
		meta: `${appComponents} de aplicación en ${appGroups.length} grupos.`,
	},
	{
		title: "Stream",
		href: "/foundations/stream/",
		text: "Alertas, escenas, chat y paneles para Twitch. Siempre en oscuro.",
		meta: `${streamComponents} componentes en ${streamGroups.length} grupos.`,
	},
	{
		title: "Iconos",
		href: "/icons/",
		text: "El set de línea de 24 px, con buscador y el código listo para copiar.",
		meta: `${icons} iconos.`,
	},
];

const container = "mx-auto w-full max-w-[1280px] px-4 lg:px-8";
const over = "m-0 text-xs font-semibold text-quaternary";
// La muestra de las cards del mapa: mismo formato que las capturas del índice (16:10), solo desde `lg`
const sample =
	"flex aspect-[16/10] items-center justify-center shadow-[inset_0_-1px_0_var(--border-secondary)]";
---

<Base title="Regula" wide>
	<section aria-labelledby="hero-t" class="relative overflow-hidden shadow-[inset_0_-1px_0_var(--border-secondary)]">
		<div aria-hidden="true" class="pointer-events-none absolute inset-0 flex justify-center">
			<BackgroundPattern pattern="grid" size="lg" mask="radial-down" width={1440} height={640} />
		</div>
		<div
			class={`relative grid grid-cols-1 items-center gap-10 py-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-16 lg:pt-20 lg:pb-22 ${container}`}
		>
			<div class="flex min-w-0 flex-col gap-5 lg:gap-6">
				<div class="flex items-center gap-3">
					<span aria-hidden="true" class="flex dark:hidden"><AppIcon app="regula" variant="light" size={40} /></span>
					<span aria-hidden="true" class="hidden dark:flex"><AppIcon app="regula" size={40} /></span>
					<p class="m-0 text-sm font-medium text-tertiary">El sistema de diseño de la suite jotis.me</p>
				</div>
				<h1
					id="hero-t"
					class="m-0 max-w-[640px] font-display text-display-md font-semibold tracking-[-0.02em] text-balance text-primary lg:text-display-xl"
				>
					Las reglas de la suite, con el código al lado.
				</h1>
				<p class="m-0 max-w-[560px] text-md text-tertiary lg:text-lg" data-counts>
					Fundamentos, tokens, {icons} iconos y {components} componentes para Vinculum, Pecunia, Emptor, Ornatus y lo
					que venga. Se consulta con una mano mientras la otra programa.
				</p>
				<div class="max-w-[560px]" data-install>
					<CodeSnippet client:visible tabs={install} lineNumbers={false} />
				</div>
				<div class="flex flex-col gap-3 lg:flex-row lg:flex-wrap lg:items-center">
					<Button size="xl" href="/start/install/" iconTrailing={ArrowRight}>Seguir la instalación</Button>
					<div class="min-w-60 lg:max-w-80 lg:flex-1">
						<Input
							size="lg"
							aria-label="Buscar en Regula"
							aria-haspopup="dialog"
							aria-keyshortcuts="Control+K Meta+K"
							placeholder="Busca lo que te falte"
							readOnly
							data-open-search
							icon={SearchLg}
						>
							<Kbd slot="trailing" variant="field">Ctrl K</Kbd>
						</Input>
					</div>
				</div>
			</div>
			<figure class="m-0 flex min-w-0 flex-col gap-3">
				<HeroForm client:visible />
				<figcaption class="pl-1 text-xs text-quaternary">No es una captura: son los componentes de verdad. Prueba a escribir.</figcaption>
			</figure>
		</div>
	</section>

	<div class={`flex flex-col gap-12 pt-10 pb-16 lg:gap-18 lg:pt-16 lg:pb-24 ${container}`}>
		<section id="reglas" aria-labelledby="reglas-t" class="flex flex-col gap-6">
			<div class="flex flex-col gap-2">
				<p class={over}>Cinco reglas, una pantalla</p>
				<div id="reglas-t"><SectionHeader title="Llega así. En cinco pasos, deja de doler." /></div>
			</div>
			{/* Una u otra según el ancho: la que no se ve no llega a hidratarse (`client:visible`) */}
			<div class="hidden lg:block" data-story="steps"><RulesStory client:visible /></div>
			<div class="lg:hidden" data-story="strip"><RulesStrip client:visible /></div>
		</section>

		<section id="asi" aria-labelledby="asi-t" class="flex flex-col gap-2">
			<p class={over}>Así se ve</p>
			<ThemeCompare client:visible />
		</section>

		<section id="mapa" aria-labelledby="mapa-t" class="flex flex-col gap-5">
			<SectionTitle id="mapa-t" title="Por dónde seguir" />
			<ul class="m-0 grid list-none grid-cols-1 gap-3 p-0 lg:grid-cols-4 lg:gap-4">
				{
					map.map((m) => (
						<LinkCard as="li" href={m.href} title={m.title} className="bg-primary">
							{/* La muestra, inerte y fuera del enlace: LinkCard estira el enlace sobre toda la card */}
							<div slot="preview" class="hidden lg:block">
								{m.title === "Fundamentos" && (
									<TransparencyGrid className={`${sample} gap-2`}>
										{swatches.map((c) => (
											<span class={`size-10 rounded-lg shadow-[inset_0_0_0_1px_var(--border-secondary)] ${c}`} />
										))}
									</TransparencyGrid>
								)}
								{m.title === "Componentes" && <ShowcaseImage name="Button" slug="button" />}
								{m.title === "Stream" && <ShowcaseImage name="StreamStatus" slug="stream-status" />}
								{m.title === "Iconos" && (
									<TransparencyGrid className={`${sample} gap-4 text-fg-secondary`}>
										{previewIcons.map((Icon) => <Icon size={24} />)}
									</TransparencyGrid>
								)}
							</div>
							<Fragment slot="description">
								{m.text}{" "}<span data-map-meta>{m.meta}</span>
							</Fragment>
						</LinkCard>
					))
				}
			</ul>
		</section>

		<section id="suite" aria-labelledby="suite-t" class="flex flex-col gap-5">
			<SectionTitle id="suite-t" title="La suite" description="Seis apps, una sola gramática." />
			<ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 lg:grid-cols-3">
				{
					apps.map(({ app, what }) => (
						<li class="flex items-center gap-3 rounded-xl border border-secondary p-3">
							<span aria-hidden="true" class="flex lg:hidden"><AppIcon app={app} size={40} /></span>
							<span aria-hidden="true" class="hidden lg:flex"><AppIcon app={app} size={48} /></span>
							<div class="flex min-w-0 flex-col">
								<p class="m-0 text-sm font-semibold text-primary">{appIcons[app].name}</p>
								<p class="m-0 text-sm text-tertiary">{what}</p>
							</div>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</Base>

<script>
	// El campo de búsqueda de la portada abre la búsqueda global (SiteSearch escucha este evento): es de solo lectura,
	// así que escribir en él no hace nada; se abre con el ratón, con Intro y con la barra espaciadora
	const open = () => window.dispatchEvent(new CustomEvent("regula:search"));
	for (const field of document.querySelectorAll<HTMLElement>("[data-open-search]")) {
		field.addEventListener("click", open);
		field.addEventListener("keydown", (e) => {
			if (e.key !== "Enter" && e.key !== " ") return;
			e.preventDefault();
			open();
		});
	}
</script>
