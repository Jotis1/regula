---
// Galería de banderas (`@jotis-me/icons/flags`). La isla (`AssetGallery`) recibe los nombres y las URL de los SVG
// del paquete, que el build copia como ficheros: se cargan como imágenes perezosas, no como código de la isla.
import AssetGallery from "../../components/AssetGallery";
import IconsNav from "../../components/IconsNav.astro";
import Base from "../../layouts/Base.astro";
import { buildEntries, encodeUrls } from "../../lib/gallery";

const urls = import.meta.glob<string>("../../../../../packages/icons/dist/flags/*.svg", {
	query: "?no-inline",
	import: "default",
	eager: true,
});
const entries = buildEntries("flags", urls);
---

<Base
	title="Banderas"
	description={`Las ${entries.length} banderas de países y regiones de @jotis-me/icons/flags, en círculo, cuadrado y rectángulo.`}
>
	<div class="flex flex-col gap-7">
		<header class="flex max-w-[720px] flex-col gap-3.5">
			<IconsNav current="flags" />
			<h1 class="font-display text-display-sm font-semibold tracking-[-0.02em] text-primary lg:text-display-md">Banderas</h1>
			<p class="text-md text-tertiary lg:text-lg">
				Las {entries.length} banderas de países y regiones, cada una en círculo (20 × 20), cuadrado (20 × 20) y rectángulo (30 × 20). Cada una es un componente suelto de <code class="font-mono text-md">@jotis-me/icons/flags</code>: tu app solo carga las que importa.
			</p>
		</header>
		<AssetGallery client:load kind="flags" urls={encodeUrls(urls)} />
	</div>
</Base>
