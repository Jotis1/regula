---
// Galería de iconos de línea de Untitled UI. La isla (`AssetGallery`) recibe los nombres y las URL de los SVG que escribe el
// endpoint `/icons/svg/`, no los dibujos: enseña los primeros y carga el resto al pedirlo. Sin JavaScript se ven los
// primeros iconos y el panel del primero.
import { PageHeader } from "@jotis-me/react";
import AssetGallery from "../../components/AssetGallery";
import IconsNav from "../../components/IconsNav.astro";
import categoriesByName from "../../data/icon-categories.json";
import Base from "../../layouts/Base.astro";
import {
	buildEntries,
	encodeCategories,
	encodeUrls,
	groupOptions,
	ICON_CATEGORIES,
	pascal,
} from "../../lib/gallery";
import { ICON_NAMES } from "../../lib/untitled";

const urls = Object.fromEntries(
	ICON_NAMES.map((n) => [`/icons/svg/icons/${n}.svg`, `/icons/svg/icons/${n}.svg`]),
);
// Las categorías del Figma van por nombre con guiones; los iconos de Untitled UI, por nombre de componente
const categories = Object.fromEntries(
	Object.entries(categoriesByName as Record<string, string[]>).map(([k, names]) => [k, names.map(pascal)]),
);
const entries = buildEntries("icons", urls, categories);
const groups = groupOptions(entries, ICON_CATEGORIES);
const total = ICON_NAMES.length;
---

<Base title="Iconos" description={`Los ${total} iconos de línea de Untitled UI que usa la suite: 24×24, trazo de 2px redondeado.`}>
	<div class="flex flex-col gap-10">
		<PageHeader title="Iconos" divider={false}>
			<Fragment slot="description">
				Los {total} iconos de línea de <a class="text-brand-secondary underline underline-offset-3" href="https://www.untitledui.com/icons">Untitled UI</a>: 24 × 24, trazo de 2 px con extremos redondos y sin relleno. Toman el color
				del texto. Elige uno y copia su código.
			</Fragment>
			<p id="icon-core-note" class="m-0 max-w-[720px] text-md text-tertiary">
				<strong class="font-semibold text-secondary">En los componentes de Regula</strong> las props de icono aceptan el
				componente (<code class="font-mono text-md">iconLeading={"{Plus}"}</code>) o un nodo, no un nombre. Cada icono se
				importa suelto de <code class="font-mono text-md">@untitledui/icons</code>: un bundler deja fuera los que no uses.
			</p>
			<IconsNav current="icons" />
		</PageHeader>
		<AssetGallery
			client:load
			kind="icons"
			urls={encodeUrls(urls)}
			categories={encodeCategories(categories)}
			groups={groups}
		/>
	</div>
</Base>
