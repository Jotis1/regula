---
// Galería de iconos de línea (reference/docs-design/Icons.dc.html e IconsM.dc.html). La isla (`AssetGallery`) recibe los
// nombres y las URL de los 1.172 SVG, no los dibujos: enseña los primeros y carga el resto al pedirlo. Sin JavaScript se ven
// los primeros iconos y el panel del primero.
import { allIconNames, iconNames } from "@jotis-me/icons";
import categories from "../../../../../packages/icons/assets/icon-categories.json";
import AssetGallery from "../../components/AssetGallery";
import IconsNav from "../../components/IconsNav.astro";
import Base from "../../layouts/Base.astro";
import { buildEntries, encodeCategories, encodeUrls, groupOptions, ICON_CATEGORIES } from "../../lib/gallery";

const urls = import.meta.glob<string>("../../../../../packages/icons/dist/svg/*.svg", {
	query: "?no-inline",
	import: "default",
	eager: true,
});
const entries = buildEntries("icons", urls, categories);
const groups = groupOptions(entries, ICON_CATEGORIES);
const total = allIconNames.length;
---

<Base title="Iconos" description={`Los ${total} iconos de línea de la suite: 24×24, trazo de 2px redondeado.`}>
	<div class="flex flex-col gap-7">
		<header class="flex max-w-[720px] flex-col gap-3.5">
			<IconsNav current="icons" />
			<h1 class="font-display text-display-sm font-semibold tracking-[-0.02em] text-primary lg:text-display-md">Iconos</h1>
			<p class="text-md text-tertiary lg:text-lg">
				Los {total} iconos de línea de la suite: 24 × 24, trazo de 2 px con extremos redondos y sin relleno. Toman el color
				del texto. Elige uno y copia su código.
			</p>
			<p id="icon-core-note" class="text-md text-tertiary">
				<strong class="font-semibold text-secondary">Si vienes de una versión anterior:</strong> el componente{" "}
				<code class="font-mono text-md">Icon</code> con <code class="font-mono text-md">name</code> acepta solo los{" "}
				{iconNames.length} iconos del núcleo, los que usan los componentes de la librería. Los demás son componentes
				sueltos, como <code class="font-mono text-md">IconRocket02</code>, que un bundler deja fuera si no se importan.
			</p>
		</header>
		<AssetGallery
			client:load
			kind="icons"
			urls={encodeUrls(urls)}
			categories={encodeCategories(categories)}
			groups={groups}
			core={[...iconNames]}
		/>
	</div>
</Base>
