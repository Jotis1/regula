---
// Historial de cambios (design §10): las versiones salen de los CHANGELOG.md de los paquetes en el build. Con los tres
// paquetes en `fixed` comparten versión, así que cada una aparece una vez. Sin versiones publicadas, un estado vacío.
import { EmptyState, PageHeader } from "@jotis-me/react";
import { Clock } from "@untitledui/icons";
import InlineCode from "../components/InlineCode.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Base from "../layouts/Base.astro";
import { type ChangeKind, changeBlocks, mergeChangelogs } from "../lib/changelog";

// Fuera del grafo de la web si no existen: `glob` devuelve `{}` y la página enseña el estado vacío
const files = import.meta.glob<string>("../../../../packages/*/CHANGELOG.md", {
	query: "?raw",
	import: "default",
	eager: true,
});
const versions = mergeChangelogs(Object.values(files));

const KINDS: Record<ChangeKind, string> = {
	major: "Cambios que rompen",
	minor: "Novedades",
	patch: "Arreglos",
};
const ORDER: ChangeKind[] = ["major", "minor", "patch"];
const short = (pkgs: string[]) =>
	pkgs.length >= 3 ? "" : pkgs.map((p) => p.replace("@jotis-me/", "")).join(", ");
---

<Base
	title="Historial de cambios"
	description="Qué ha cambiado en cada versión de @jotis-me/react, @jotis-me/tokens y @jotis-me/assets."
>
	<div class="flex flex-col gap-10">
		<PageHeader title="Historial de cambios" breadcrumbs={[{ label: "Historial de cambios" }]} divider={false}>
			<Fragment slot="description">
				Qué ha cambiado en cada versión. Los tres paquetes (<code class="font-mono">@jotis-me/react</code>,
				<code class="font-mono">tokens</code> e <code class="font-mono">icons</code>) comparten número de versión.
			</Fragment>
		</PageHeader>
	<article class="flex max-w-[720px] flex-col gap-14">
		{
			versions.length === 0 ? (
				<EmptyState
					icon={Clock}
					title="Aún no hay versiones publicadas"
					description="Cuando se publique la primera, sus cambios aparecerán aquí."
				/>
			) : (
				versions.map((v) => (
					<section aria-labelledby={`v${v.version}`} class="flex flex-col gap-6" data-version={v.version}>
						<SectionTitle id={`v${v.version}`} title={v.version} />
						{ORDER.filter((kind) => v.entries.some((e) => e.kind === kind)).map((kind) => (
							<section>
								<h3 class="mb-3 text-md font-semibold text-primary">{KINDS[kind]}</h3>
								<ul class="flex flex-col gap-3">
									{v.entries
										.filter((e) => e.kind === kind)
										.map((e) => (
											<li class="flex flex-col gap-2 text-md text-secondary">
												{changeBlocks(e.text).map((b) =>
													b.type === "p" ? (
														<p>
															<InlineCode text={b.text} />
														</p>
													) : (
														<ul class="flex list-disc flex-col gap-1.5 pl-5 marker:text-quaternary">
															{b.items.map((item) => (
																<li>
																	<InlineCode text={item} />
																</li>
															))}
														</ul>
													),
												)}
												{short(e.pkgs) && <span class="font-mono text-xs text-quaternary">{short(e.pkgs)}</span>}
											</li>
										))}
								</ul>
							</section>
						))}
					</section>
				))
			)
		}
	</article>
	</div>
</Base>
