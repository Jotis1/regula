---
import { getCollection, render } from "astro:content";
import TokenTables from "../../components/TokenTables.astro";
import FoundationPage from "../../layouts/FoundationPage.astro";

export async function getStaticPaths() {
	const pages = await getCollection("foundations");
	return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
---

<FoundationPage
	slug={page.id}
	title={page.data.title}
	description={page.data.description}
	headings={headings}
	source={`apps/docs/${page.filePath}`}
>
	<Content />
	<TokenTables page={page.id} />
</FoundationPage>
