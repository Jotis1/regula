---
// Página de fundamentos (reference/docs-design/Tone.dc.html y ToneM.dc.html): migas, título y entrada, el índice
// «En esta página» (columna en escritorio, desplegable en móvil), el contenido y anterior/siguiente en el orden de la
// guía (catálogo). Sin JavaScript el índice es una lista de enlaces; con él, marca la sección que se lee (design §7).
import { Breadcrumbs, Button } from "@jotis-me/react";
import { FOUNDATIONS } from "../lib/catalog";
import Base from "./Base.astro";

interface Props {
	slug: string;
	title: string;
	description?: string;
	/** Secciones de la página (los h2), para el índice. */
	headings: { depth: number; slug: string; text: string }[];
	/** Fichero fuente, relativo a la raíz del repositorio, para «Proponer un cambio». */
	source: string;
}
const { slug, title, description, headings, source } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
const index = FOUNDATIONS.findIndex((f) => f.slug === slug);
const prev = index > 0 ? FOUNDATIONS[index - 1] : undefined;
const next = index >= 0 && index < FOUNDATIONS.length - 1 ? FOUNDATIONS[index + 1] : undefined;
const crumbs =
	slug === "stream"
		? [{ label: "Stream", href: "/foundations/stream/" }, { label: title }]
		: [{ label: "Fundamentos", href: "/foundations/principles/" }, { label: title }];
const tocLink =
	"block py-1 pl-3 text-[13px] leading-5 text-tertiary shadow-[inset_1px_0_0_var(--border-secondary)] hover:text-primary focus-visible:rounded-sm focus-visible:shadow-focus-ring focus-visible:outline-none aria-[current=true]:font-medium aria-[current=true]:text-primary aria-[current=true]:shadow-[inset_2px_0_0_var(--fg-brand-primary)]";
const pager =
	"flex flex-1 basis-60 flex-col gap-0.5 rounded-xl p-4 text-primary no-underline shadow-[inset_0_0_0_1px_var(--border-secondary)] hover:bg-primary_hover focus-visible:shadow-focus-ring focus-visible:outline-none";
---

<Base title={title} description={description}>
	<div class="flex gap-12">
		<article class="prose min-w-0 max-w-[720px] flex-1">
			<header class="not-prose mb-10 flex flex-col gap-3 lg:gap-4">
				<Breadcrumbs items={crumbs} />
				<h1 class="font-display text-display-sm font-semibold tracking-[-0.02em] text-primary lg:text-display-md">{title}</h1>
				{description && <p class="text-md text-tertiary lg:text-lg">{description}</p>}
				{
					toc.length > 1 && (
						<details class="mt-1 rounded-lg shadow-[inset_0_0_0_1px_var(--border-secondary)] xl:hidden">
							<summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 px-3.5 text-sm font-semibold text-secondary [&::-webkit-details-marker]:hidden">
								En esta página
							</summary>
							<div class="flex flex-col gap-1 px-3.5 pb-3.5">
								{toc.map((h) => (
									<a href={`#${h.slug}`} class={tocLink}>
										{h.text}
									</a>
								))}
							</div>
						</details>
					)
				}
			</header>
			<slot />
			{
				(prev || next) && (
					<nav aria-label="Anterior y siguiente" class="not-prose mt-14 flex flex-col gap-3 md:flex-row md:flex-wrap md:gap-4">
						{prev && (
							<a href={`/foundations/${prev.slug}/`} class={pager} rel="prev">
								<span class="text-xs text-tertiary">Anterior</span>
								<span class="text-md font-semibold">{prev.label}</span>
							</a>
						)}
						{next && (
							<a href={`/foundations/${next.slug}/`} class={`${pager} text-right`} rel="next">
								<span class="text-xs text-tertiary">Siguiente</span>
								<span class="text-md font-semibold">{next.label}</span>
							</a>
						)}
					</nav>
				)
			}
		</article>
		<nav aria-label="En esta página" class="sticky top-8 hidden w-[200px] shrink-0 flex-col gap-2 self-start pt-1 xl:flex" data-toc>
			{
				toc.length > 1 && (
					<>
						<p class="mb-1 text-xs font-semibold text-quaternary">En esta página</p>
						{toc.map((h) => (
							<a href={`#${h.slug}`} class={tocLink} data-toc-link={h.slug}>
								{h.text}
							</a>
						))}
					</>
				)
			}
			<div class="mt-4">
				<Button
					hierarchy="link-gray"
					size="sm"
					iconLeading="edit-02"
					href={`https://github.com/Jotis1/regula/edit/main/${source}`}
				>
					Proponer un cambio
				</Button>
			</div>
		</nav>
	</div>
</Base>

<script>
	// Marca en el índice la sección que se está leyendo: la última cuyo título ya ha pasado del 30 % superior de la
	// ventana, o la última de todas al llegar al final (si no, la última sección corta no se marcaría nunca)
	for (const toc of document.querySelectorAll<HTMLElement>("[data-toc]")) {
		const links = [...toc.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
		const targets = links
			.map((a) => document.getElementById(a.dataset.tocLink ?? ""))
			.filter((el): el is HTMLElement => !!el);
		if (!targets.length) continue;
		let frame = 0;
		const mark = () => {
			frame = 0;
			let current: HTMLElement | undefined = targets[0];
			for (const t of targets) if (t.getBoundingClientRect().top < innerHeight * 0.3) current = t;
			if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) current = targets.at(-1);
			for (const a of links) a.setAttribute("aria-current", String(a.dataset.tocLink === current?.id));
		};
		addEventListener("scroll", () => {
			frame ||= requestAnimationFrame(mark);
		}, { passive: true });
		mark();
	}
</script>
