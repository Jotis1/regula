---
// Página de fundamentos (design D1 de redesign-docs-site-v2): `PageHeader` con migas, título y entrada; el contenido en
// la columna de lectura, con cada `##` como `SectionHeader` (MdxH2); el índice «En esta página» a la derecha (solo en
// escritorio) y anterior/siguiente en el orden de la guía (catálogo). Sin JavaScript el índice es una lista de enlaces;
// con él, marca la sección que se lee con `aria-current="location"`.
import { Button, PageHeader, Pager } from "@jotis-me/react";
import { Edit02 } from "@untitledui/icons";
import PageToc from "../components/PageToc.astro";
import { FOUNDATIONS } from "../lib/catalog";
import { PAGE_BODY } from "../lib/layout";
import Base from "./Base.astro";

interface Props {
	slug: string;
	title: string;
	description?: string;
	/** Secciones de la página (los h2), para el índice. */
	headings: { depth: number; slug: string; text: string }[];
	/** Fichero fuente, relativo a la raíz del repositorio, para «Proponer un cambio». */
	source: string;
}
const { slug, title, description, headings, source } = Astro.props;
const edit = `https://github.com/Jotis1/regula/edit/main/${source}`;
const toc = headings.filter((h) => h.depth === 2);
// El recorrido de lectura: la portada, la instalación y los fundamentos en el orden de la guía
const path = [
	{ slug: "home", label: "Qué es Regula", href: "/" },
	{ slug: "install", label: "Instalación", href: "/start/install/" },
	...FOUNDATIONS.map((f) => ({ ...f, href: `/foundations/${f.slug}/` })),
];
const index = path.findIndex((p) => p.slug === slug);
const prev = index > 0 ? path[index - 1] : undefined;
const next = index > 0 && index < path.length - 1 ? path[index + 1] : undefined;
const crumbs =
	slug === "stream"
		? [{ label: "Stream", href: "/foundations/stream/" }, { label: title }]
		: slug === "install"
			? [{ label: "Empezar", href: "/" }, { label: title }]
			: [{ label: "Fundamentos", href: "/foundations/principles/" }, { label: title }];
---

<Base title={title} description={description}>
	<div class="flex flex-col gap-10">
		<PageHeader title={title} description={description} breadcrumbs={crumbs} divider={false} />
		<div class="flex items-start gap-16">
			<article class={PAGE_BODY}>
				<slot />
				<Pager className="not-prose mt-14" prev={prev} next={next} />
			</article>
			<PageToc items={toc}>
				<div class="mt-4">
					<Button hierarchy="link-gray" size="sm" iconLeading={Edit02} href={edit}>
						Proponer un cambio
					</Button>
				</div>
			</PageToc>
		</div>
	</div>
</Base>

<script>
	import { initToc } from "../lib/toc";

	initToc();
</script>
