---
// Página de fundamentos (reference/docs-design/Tone.dc.html y ToneM.dc.html): migas, título y entrada, el índice
// «En esta página» (columna en escritorio, desplegable en móvil), el contenido y anterior/siguiente en el orden de la
// guía (catálogo). Sin JavaScript el índice es una lista de enlaces; con él, marca la sección que se lee (design §7).
import { Breadcrumbs, Button } from "@jotis-me/react";
import { FOUNDATIONS } from "../lib/catalog";
import { PAGER, TOC_LINK } from "../lib/toc";
import Base from "./Base.astro";

interface Props {
	slug: string;
	title: string;
	description?: string;
	/** Secciones de la página (los h2), para el índice. */
	headings: { depth: number; slug: string; text: string }[];
	/** Fichero fuente, relativo a la raíz del repositorio, para «Proponer un cambio». */
	source: string;
	/** A todo el ancho, con el índice en línea bajo la entrada en lugar de en columna (Color.dc.html). */
	wide?: boolean;
}
const { slug, title, description, headings, source, wide = false } = Astro.props;
const edit = `https://github.com/Jotis1/regula/edit/main/${source}`;
const toc = headings.filter((h) => h.depth === 2);
// El recorrido de lectura: la portada, la instalación y los fundamentos en el orden de la guía
const path = [
	{ slug: "home", label: "Qué es Regula", href: "/" },
	{ slug: "install", label: "Instalación", href: "/start/install/" },
	...FOUNDATIONS.map((f) => ({ ...f, href: `/foundations/${f.slug}/` })),
];
const index = path.findIndex((p) => p.slug === slug);
const prev = index > 0 ? path[index - 1] : undefined;
const next = index > 0 && index < path.length - 1 ? path[index + 1] : undefined;
const crumbs =
	slug === "stream"
		? [{ label: "Stream", href: "/foundations/stream/" }, { label: title }]
		: slug === "install"
			? [{ label: "Empezar", href: "/" }, { label: title }]
			: [{ label: "Fundamentos", href: "/foundations/principles/" }, { label: title }];
const tocLink = TOC_LINK;
const pager = PAGER;
---

<Base title={title} description={description}>
	<div class="flex gap-12">
		<article class:list={["prose min-w-0 flex-1", wide ? "max-w-none" : "max-w-[720px]"]}>
			<header class="not-prose mb-10 flex flex-col gap-3 lg:gap-4">
				<Breadcrumbs items={crumbs} />
				<h1 class="font-display text-display-sm font-semibold tracking-[-0.02em] text-primary lg:text-display-md">{title}</h1>
				{description && <p class="max-w-[720px] text-md text-tertiary lg:text-lg">{description}</p>}
				{
					wide && toc.length > 1 && (
						<nav aria-label="En esta página" class="hidden flex-wrap gap-x-5 gap-y-2 pt-1 xl:flex" data-toc>
							{toc.map((h) => (
								<a
									href={`#${h.slug}`}
									data-toc-link={h.slug}
									class="rounded-sm text-sm text-brand-secondary underline underline-offset-3 hover:text-brand-secondary_hover hover:decoration-2 focus-visible:shadow-focus-ring focus-visible:outline-none aria-[current=true]:font-semibold"
								>
									{h.text}
								</a>
							))}
						</nav>
					)
				}
				{
					toc.length > 1 && (
						<details class="mt-1 rounded-lg shadow-[inset_0_0_0_1px_var(--border-secondary)] xl:hidden">
							<summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 px-3.5 text-sm font-semibold text-secondary [&::-webkit-details-marker]:hidden">
								En esta página
							</summary>
							<div class="flex flex-col gap-1 px-3.5 pb-3.5">
								{toc.map((h) => (
									<a href={`#${h.slug}`} class={tocLink}>
										{h.text}
									</a>
								))}
							</div>
						</details>
					)
				}
			</header>
			<slot />
			{
				(prev || next) && (
					<nav aria-label="Anterior y siguiente" class="not-prose mt-14 flex flex-col gap-3 md:flex-row md:flex-wrap md:gap-4">
						{prev && (
							<a href={prev.href} class={pager} rel="prev">
								<span class="text-xs text-tertiary">Anterior</span>
								<span class="text-md font-semibold">{prev.label}</span>
							</a>
						)}
						{next && (
							<a href={next.href} class={`${pager} text-right`} rel="next">
								<span class="text-xs text-tertiary">Siguiente</span>
								<span class="text-md font-semibold">{next.label}</span>
							</a>
						)}
					</nav>
				)
			}
			{
				wide && (
					<div class="not-prose mt-6">
						<Button hierarchy="link-gray" size="sm" iconLeading="edit-02" href={edit}>
							Proponer un cambio
						</Button>
					</div>
				)
			}
		</article>
		{!wide && (
		<nav aria-label="En esta página" class="sticky top-8 hidden w-[200px] shrink-0 flex-col gap-2 self-start pt-1 xl:flex" data-toc>
			{
				toc.length > 1 && (
					<>
						<p class="mb-1 text-xs font-semibold text-quaternary">En esta página</p>
						{toc.map((h) => (
							<a href={`#${h.slug}`} class={tocLink} data-toc-link={h.slug}>
								{h.text}
							</a>
						))}
					</>
				)
			}
			<div class="mt-4">
				<Button
					hierarchy="link-gray"
					size="sm"
					iconLeading="edit-02"
					href={edit}
				>
					Proponer un cambio
				</Button>
			</div>
		</nav>
		)}
	</div>
</Base>

<script>
	import { initToc } from "../lib/toc";

	initToc();
</script>
