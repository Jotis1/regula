---
// Página de un componente (reference/docs-design/Button.dc.html y ButtonM.dc.html): migas Componentes › grupo ›
// nombre, insignia del grupo, descripción, línea de importación y nota de Astro; «Cuándo usarlo» (la ficha),
// variantes (el ejemplo del registro), props, código, «Detalles y accesibilidad» (el resto de la ficha) y
// anterior/siguiente. A la derecha, el índice «En esta página» y los relacionados del catálogo (design §2).
import { Badge, Breadcrumbs, Button, Icon, Pager } from "@jotis-me/react";
import CardSections from "../components/CardSections.astro";
import CodeSnippet from "../components/CodeSnippetIsland";
import InlineCode from "../components/InlineCode.astro";
import Playground from "../components/Playground";
import PropsTable from "../components/PropsTable.astro";
import StreamNote from "../components/StreamNote.astro";
import type { SplitCard } from "../lib/card";
import { groupOf, labelOf, neighborsOf, SECTIONS, slugOf } from "../lib/catalog";
import { inline } from "../lib/inline";
import type { Playground as PlaygroundData } from "../lib/playground";
import type { PropRow } from "../lib/props";
import { TOC_LINK } from "../lib/toc";
import { compositionsOf } from "../visual/compositions";
import Base from "./Base.astro";

interface Props {
	name: string;
	description: string;
	/** La ficha de la guía repartida por etiqueta (`splitCard`). */
	card: SplitCard;
	props: PropRow[];
	/** Uso en Next.js: el componente tal cual. */
	next: string;
	/** Uso en Astro: con la directiva `client:*` si es interactivo. */
	astro: string;
	/** Necesita `client:*` en Astro para responder. */
	interactive?: boolean;
	/** Aviso bajo el fragmento de Astro (props función, islas). */
	astroNote?: string;
	/** Ejemplos sobre fondo oscuro, como sus vistas previas de la guía (Stream: `DARK_PREVIEWS`). */
	dark?: boolean;
	/** Playground generado de sus props (src/lib/playground.ts); sin él, la página enseña solo sus ejemplos. */
	playground?: PlaygroundData;
}
const {
	name,
	description,
	card,
	props,
	next,
	astro,
	interactive = false,
	astroNote,
	dark = false,
	playground,
} = Astro.props;

const group = groupOf(name);
const section = SECTIONS.find((s) => s.id === (group?.section ?? "components"));
const label = labelOf(name);
const crumbs = [
	...(section ? [{ label: section.label, href: section.href }] : []),
	...(group ? [{ label: group.label, href: `/components/#${group.id}` }] : []),
	{ label },
];
const { prev, next: following, related } = neighborsOf(name);
const href = (c: string) => `/components/${slugOf(c)}/`;
// Los de Stream (Scene.dc.html): insignia «Siempre en oscuro», nota del tema bajo el primer ejemplo, nota de OBS
// bajo el código y la guía de Stream entre los relacionados
const stream = group?.section === "stream";

// Los tipos del Figma montados como composiciones (design D7), en su propia página
const compositions = compositionsOf(name);

const has = (...ids: string[]) => card.sections.some((s) => ids.includes(s.id));
const toc = [
	playground && { slug: "ejemplo", text: "Ejemplo" },
	has("uso", "evita") && { slug: "uso", text: "Cuándo usarlo" },
	{ slug: "variantes", text: "Variantes y estados" },
	compositions.length > 0 && { slug: "composiciones", text: "Composiciones" },
	{ slug: "props", text: "Props" },
	{ slug: "codigo", text: "Código" },
	has("detalles", "accesibilidad", "amplia") && { slug: "detalles", text: "Detalles y accesibilidad" },
].filter((t): t is { slug: string; text: string } => !!t);
---

<Base title={label} description={description}>
	<div class="flex gap-12">
		<article class="prose min-w-0 max-w-none flex-1">
			<header class="not-prose mb-10 flex flex-col gap-3.5">
				<!-- En móvil, sin el grupo, como ButtonM: con él no caben en 390px -->
				<Breadcrumbs items={crumbs} className="hidden md:block" />
				<Breadcrumbs items={[crumbs[0], crumbs.at(-1)].filter((c) => c !== undefined)} className="md:hidden" />
				<div class="flex flex-wrap items-center gap-x-4 gap-y-3">
					<h1 class="font-display text-display-sm font-semibold tracking-[-0.02em] text-primary lg:text-display-md">{label}</h1>
					{group && <Badge color="gray" size="sm">{stream ? `Stream · ${group.label}` : group.label}</Badge>}
					{stream && <Badge color="gray" size="sm" icon="moon-01">Siempre en oscuro</Badge>}
				</div>
				<p class="max-w-[680px] text-md text-tertiary lg:text-lg"><InlineCode text={description} /></p>
				<dl class="mt-1 hidden flex-wrap gap-x-7 gap-y-2 text-[13px] leading-5 md:flex">
					<div class="flex gap-1.5">
						<dt class="text-quaternary">Importar</dt>
						<dd class="font-mono text-secondary">{`import { ${name} } from "@jotis-me/react"`}</dd>
					</div>
					<div class="flex gap-1.5">
						<dt class="text-quaternary">En Astro</dt>
						<dd class="text-secondary">
							{interactive ? <>Isla con <code class="font-mono">client:load</code></> : "Sin isla: se pinta en el servidor"}
						</dd>
					</div>
				</dl>
				{
					toc.length > 0 && (
						<details class="mt-1 rounded-lg shadow-[inset_0_0_0_1px_var(--border-secondary)] xl:hidden">
							<summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 px-3.5 text-sm font-semibold text-secondary [&::-webkit-details-marker]:hidden">
								En esta página
							</summary>
							<div class="flex flex-col gap-1 px-3.5 pb-3.5">
								{toc.map((h) => (
									<a href={`#${h.slug}`} class={TOC_LINK}>
										{h.text}
									</a>
								))}
							</div>
						</details>
					)
				}
			</header>

			{
				playground && (
					<section aria-labelledby="ejemplo" data-pagefind-ignore>
						<h2 id="ejemplo">Ejemplo interactivo</h2>
						<div class="not-prose my-4">
							<Playground client:visible playground={playground} />
						</div>
						{stream && <StreamNote name={name} />}
					</section>
				)
			}

			<CardSections card={card} part="uso" />

			<section aria-labelledby="variantes">
				<h2 id="variantes">Variantes y estados</h2>
				{/* Contenedor: un ejemplo puede adaptarse al ancho de la caja (StreamAlert pasa a una columna) sin cambiar en
				    /visual/, donde no hay contenedor y la paridad compara con la captura de la guía */}
				<div
					data-pagefind-ignore
					role="region"
					aria-label={`Variantes de ${label}`}
					tabindex="0"
					class:list={[
						"@container not-prose my-4 flex flex-col gap-6 overflow-x-auto rounded-xl p-6 shadow-[inset_0_0_0_1px_var(--border-secondary)] focus-visible:shadow-focus-ring focus-visible:outline-none",
						dark && "dark-mode bg-primary text-primary",
					]}
				>
					<slot name="examples" />
				</div>
				{stream && !playground && <StreamNote name={name} />}
			</section>

			{
				compositions.length > 0 && (
					<section aria-labelledby="composiciones">
						<h2 id="composiciones">Composiciones</h2>
						<p>
							Los {compositions.length} tipos del Figma de {label} ({compositions.slice(0, 3).map((c) => c.title.toLowerCase()).join(", ")}…), hechos con componentes de Regula y con su código para copiar.
						</p>
						<div class="not-prose my-4">
							<Button hierarchy="secondary" iconTrailing="arrow-right" href={`/components/${slugOf(name)}/composiciones/`}>
								Ver las {compositions.length} composiciones
							</Button>
						</div>
					</section>
				)
			}

			<section aria-labelledby="props">
				<h2 id="props">Props</h2>
				<!-- En móvil la tabla se desplaza dentro de su caja; con teclado, la caja recibe el foco para desplazarla -->
				<div
					role="region"
					aria-label={`Props de ${label}`}
					tabindex="0"
					class="overflow-x-auto rounded-sm focus-visible:shadow-focus-ring focus-visible:outline-none"
				>
					<PropsTable rows={props} />
				</div>
				{card.props && <p class="text-sm text-tertiary" set:html={inline(card.props.raw)} />}
			</section>

			<section aria-labelledby="codigo">
				<h2 id="codigo">Código</h2>
				<div class="not-prose my-4" data-code-tabs>
					<CodeSnippet
						client:visible
						tabs={[
							{ label: "Next.js", code: next },
							{ label: "Astro", code: astro },
						]}
					/>
				</div>
				{
					astroNote && (
						<div class="not-prose my-4 flex gap-3 rounded-xl bg-secondary p-4 shadow-[inset_0_0_0_1px_var(--border-secondary)]">
							<Icon name="info-circle" size={20} className="mt-px flex-none text-fg-quaternary" />
							<p class="text-sm text-secondary">
								<strong class="font-semibold text-primary">Isla en Astro.</strong> <InlineCode text={astroNote} />
							</p>
						</div>
					)
				}
				{
					stream && (
						<div class="not-prose my-4 flex gap-3 rounded-xl bg-secondary p-4 shadow-[inset_0_0_0_1px_var(--border-secondary)]" data-obs-note>
							<Icon name="play" size={20} className="mt-px flex-none text-fg-quaternary" />
							<p class="text-sm text-secondary">
								<strong class="font-semibold text-primary">En OBS.</strong> Móntalo en una página de tu app (Astro o Next) y añádela como fuente de navegador con el fondo transparente.
							</p>
						</div>
					)
				}
			</section>

			<CardSections card={card} part="detalles" />

			<Pager
				className="not-prose mt-14"
				prev={prev ? { href: href(prev), label: labelOf(prev) } : undefined}
				next={following ? { href: href(following), label: labelOf(following) } : undefined}
			/>
		</article>
		<nav aria-label="En esta página" class="sticky top-8 hidden w-[184px] shrink-0 flex-col gap-2 self-start pt-1 xl:flex" data-toc>
			<p class="mb-1 text-xs font-semibold text-quaternary">En esta página</p>
			{
				toc.map((h) => (
					<a href={`#${h.slug}`} class={TOC_LINK} data-toc-link={h.slug}>
						{h.text}
					</a>
				))
			}
			{
				(related.length > 0 || stream) && (
					<>
						<p class="mt-5 mb-1 text-xs font-semibold text-quaternary">Relacionados</p>
						{related.map((c) => (
							<a href={href(c)} class={TOC_LINK}>
								{labelOf(c)}
							</a>
						))}
						{stream && (
							<a href="/foundations/stream/" class={TOC_LINK}>
								Guía de Stream
							</a>
						)}
					</>
				)
			}
		</nav>
	</div>
</Base>

<script>
	import { initToc } from "../lib/toc";

	initToc();
</script>
