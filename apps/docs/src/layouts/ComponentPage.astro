---
import { readFileSync } from "node:fs";
import { join } from "node:path";
// Página de un componente (design D1 de redesign-docs-site-v2): `PageHeader` con migas Componentes › grupo › nombre,
// descripción, insignia del grupo, la importación en un `Input` de solo lectura con su botón de copiar y la nota de
// Astro; después, cada sección con su `SectionHeader` (SectionTitle): el ejemplo interactivo, «Cuándo usarlo» (la
// ficha, con sus pares de ejemplo), props, código, «Detalles y accesibilidad» (el resto de la ficha), los relacionados
// del catálogo como `LinkCard` y anterior/siguiente. A la derecha, el índice «En esta página».
import { Badge, Button, Input, LinkCard, PageHeader, Pager } from "@jotis-me/react";
import { ArrowRight, Copy01, InfoCircle, Moon01, Play } from "@untitledui/icons";
import CardSections from "../components/CardSections.astro";
import CodeSnippet from "../components/CodeSnippetIsland";
import InlineCode from "../components/InlineCode.astro";
import PageToc from "../components/PageToc.astro";
import Playground from "../components/Playground";
import PropsTable from "../components/PropsTable.astro";
import SectionTitle from "../components/SectionTitle.astro";
import StreamNote from "../components/StreamNote.astro";
import { type SplitCard, usageOf, usageToc } from "../lib/card";
import { groupOf, labelOf, neighborsOf, SECTIONS, slugOf } from "../lib/catalog";
import { compositionCode } from "../lib/composition-code";
import { inline } from "../lib/inline";
import { PAGE_SECTIONS } from "../lib/layout";
import { type Playground as PlaygroundData, STARTS } from "../lib/playground";
import type { PropRow } from "../lib/props";
import { COMPOSITION_FILES, compositionsOf, INLINE_COMPOSITIONS } from "../visual/compositions";
import VisualExample from "../visual/VisualExample";
import Base from "./Base.astro";

interface Props {
	name: string;
	description: string;
	/** La ficha de la guía repartida por etiqueta (`splitCard`). */
	card: SplitCard;
	props: PropRow[];
	/** Uso en Next.js: el componente tal cual. */
	next: string;
	/** Uso en Astro: con la directiva `client:*` si es interactivo. */
	astro: string;
	/** Necesita `client:*` en Astro para responder. */
	interactive?: boolean;
	/** Aviso bajo el fragmento de Astro (props función, islas). */
	astroNote?: string;
	/** Playground generado de sus props (src/lib/playground.ts); sin él, la página enseña solo sus ejemplos. */
	playground?: PlaygroundData;
	/** La descripción de cada componente por su nombre, para las tarjetas de relacionados. */
	descriptions?: Record<string, string>;
}
const {
	descriptions = {},
	name,
	description,
	card,
	props,
	next,
	astro,
	interactive = false,
	astroNote,
	playground,
} = Astro.props;

const group = groupOf(name);
const section = SECTIONS.find((s) => s.id === (group?.section ?? "components"));
const label = labelOf(name);
const crumbs = [
	...(section ? [{ label: section.label, href: section.href }] : []),
	...(group ? [{ label: group.label, href: `/components/#${group.id}` }] : []),
	{ label },
];
const { prev, next: following } = neighborsOf(name);
const href = (c: string) => `/components/${slugOf(c)}/`;
// Los de Stream (Scene.dc.html): insignia «Siempre en oscuro», nota del tema bajo el primer ejemplo, nota de OBS
// bajo el código y la guía de Stream entre los relacionados
const stream = group?.section === "stream";

// Los tipos del Figma montados como composiciones (design D7), en su propia página
const compositions = compositionsOf(name);
// Pocas (el modal del selector de color): en esta página, con su código; muchas: en su propia página
const inlineCompositions = compositions.length > 0 && compositions.length <= INLINE_COMPOSITIONS;
const compositionSource = inlineCompositions
	? readFileSync(join(process.cwd(), "src/visual/examples", `${COMPOSITION_FILES[name]}.tsx`), "utf8")
	: "";

const importLine = `import { ${name} } from "@jotis-me/react"`;
// «Cuándo usarlo» y «Evita»: el texto de la ficha con los pares de ejemplo del arranque del componente
const usage = usageOf(card, STARTS[name]?.examples);
// Relacionados, al final de la página (Main.dc.html): los tres siguientes de su grupo, y la guía en los de Stream
const siblings = group ? [...group.components] : [];
const at = siblings.findIndex((c) => slugOf(c) === slugOf(name));
const relatedCards = [
	...(at < 0 ? [] : [...siblings.slice(at + 1), ...siblings.slice(0, at)].slice(0, 3)).map((c) => ({
		href: href(c),
		title: labelOf(c),
		description: descriptions[c] ?? "",
	})),
	...(stream
		? [
				{
					href: "/foundations/stream/",
					title: "Guía de Stream",
					description:
						"Componentes para directos: alertas, escenas, overlay y canal, siempre en oscuro.",
				},
			]
		: []),
];
const has = (...ids: string[]) => usage.card.sections.some((s) => ids.includes(s.id));
const toc = [
	playground && { slug: "ejemplo", text: "Ejemplo" },
	...usageToc(usage),
	compositions.length > 0 && { slug: "composiciones", text: "Composiciones" },
	{ slug: "props", text: "Props" },
	{ slug: "codigo", text: "Código" },
	has("detalles", "accesibilidad", "amplia") && { slug: "detalles", text: "Detalles y accesibilidad" },
	relatedCards.length > 0 && { slug: "relacionados", text: "Relacionados" },
].filter((t): t is { slug: string; text: string } => !!t);
---

<Base title={label} description={description}>
	<div class="flex flex-col gap-10">
		<PageHeader title={label} breadcrumbs={crumbs} divider={false}>
			<InlineCode slot="description" text={description} />
			{
				group && (
					<div class="flex flex-wrap gap-2">
						<Badge color="gray" size="sm">{stream ? `Stream · ${group.label}` : group.label}</Badge>
						{stream && <Badge color="gray" size="sm" icon={Moon01}>Siempre en oscuro</Badge>}
					</div>
				)
			}
			{/* La copia la hace `CopyTooltip` de Base: pulsar cualquier elemento con `data-copy` copia su valor */}
			<div class="max-w-[520px]" data-copy={importLine} data-import>
				<Input size="sm" label="Importación" readOnly value={importLine} trailingButton={{ label: "Copiar", icon: Copy01 }} />
			</div>
			<p class="m-0 max-w-[720px] text-sm text-tertiary">
				<span class="font-semibold text-secondary">En Astro.</span>{" "}
				{interactive ? <>Isla con <code class="font-mono">client:load</code>.</> : "Sin isla: se pinta en el servidor."}
			</p>
		</PageHeader>
		<div class="flex items-start gap-16">
		<article class={PAGE_SECTIONS}>
			{
				playground && (
					<section aria-labelledby="ejemplo" data-pagefind-ignore class="flex flex-col gap-5">
						<SectionTitle id="ejemplo" title="Ejemplo interactivo" />
						<div class="not-prose">
							<Playground client:visible playground={playground} rows={props} />
						</div>
						{stream && <StreamNote name={name} />}
					</section>
				)
			}

			<CardSections name={name} usage={usage} part="uso" />

			{
				compositions.length > 0 && (
					<section aria-labelledby="composiciones" class="flex flex-col gap-5">
						<SectionTitle id="composiciones" title="Composiciones" />
						{inlineCompositions ? (
							<>
								<p>Montadas con componentes de Regula, con su código para copiar. No se exportan del paquete.</p>
								{compositions.map((c) => (
									<div data-composition={c.name}>
										<h3>{c.title}</h3>
										<div
											data-pagefind-ignore
											role="region"
											aria-label={`Composición ${c.title}`}
											tabindex="0"
											class="not-prose my-4 overflow-x-auto rounded-xl p-4 shadow-[inset_0_0_0_1px_var(--border-secondary)] focus-visible:shadow-focus-ring focus-visible:outline-none"
										>
											<div class="min-w-[640px]">
												<VisualExample client:visible name={c.name} />
											</div>
										</div>
										<div class="not-prose my-4">
											<CodeSnippet client:visible language="tsx" code={compositionCode(compositionSource, c.name)} />
										</div>
									</div>
								))}
							</>
						) : (
							<>
								<p>
									Los {compositions.length} tipos del Figma de {label} ({compositions.slice(0, 3).map((c) => c.title.toLowerCase()).join(", ")}…), hechos con componentes de Regula y con su código para copiar.
								</p>
								<div class="not-prose my-4">
									<Button hierarchy="secondary" iconTrailing={ArrowRight} href={`/components/${slugOf(name)}/composiciones/`}>
										Ver las {compositions.length} composiciones
									</Button>
								</div>
							</>
						)}
					</section>
				)
			}

			<section aria-labelledby="props" class="flex flex-col gap-5">
				<SectionTitle id="props" title="Props" />
				<!-- Desde `lg`, la tabla en su caja; por debajo, una lista plegable, una prop por fila -->
				<PropsTable rows={props} label={label} />
				{card.props && <p class="m-0 text-sm text-tertiary" set:html={inline(card.props.raw)} />}
			</section>

			<section aria-labelledby="codigo" class="flex flex-col gap-5">
				<SectionTitle id="codigo" title="Código" />
				<div class="not-prose" data-code-tabs>
					<CodeSnippet
						client:visible
						tabs={[
							{ label: "Next.js", code: next },
							{ label: "Astro", code: astro },
						]}
					/>
				</div>
				{
					astroNote && (
						<div class="not-prose flex gap-3 rounded-xl bg-secondary p-4 shadow-[inset_0_0_0_1px_var(--border-secondary)]">
							<InfoCircle size={20} className="mt-px flex-none text-fg-quaternary" />
							<p class="text-sm text-secondary">
								<strong class="font-semibold text-primary">Isla en Astro.</strong> <InlineCode text={astroNote} />
							</p>
						</div>
					)
				}
				{
					stream && (
						<div class="not-prose flex gap-3 rounded-xl bg-secondary p-4 shadow-[inset_0_0_0_1px_var(--border-secondary)]" data-obs-note>
							<Play size={20} className="mt-px flex-none text-fg-quaternary" />
							<p class="text-sm text-secondary">
								<strong class="font-semibold text-primary">En OBS.</strong> Móntalo en una página de tu app (Astro o Next) y añádela como fuente de navegador con el fondo transparente.
							</p>
						</div>
					)
				}
			</section>

			<CardSections name={name} usage={usage} part="detalles" />

			{
				relatedCards.length > 0 && (
					<section aria-labelledby="relacionados" class="flex flex-col gap-5">
						<SectionTitle id="relacionados" title="Relacionados" />
						<nav aria-label="Relacionados" class="not-prose">
							<ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
								{relatedCards.map((c) => (
									<LinkCard as="li" href={c.href} title={c.title}>
										<InlineCode slot="description" text={c.description} />
									</LinkCard>
								))}
							</ul>
						</nav>
					</section>
				)
			}

			<Pager
				className="not-prose"
				prev={prev ? { href: href(prev), label: labelOf(prev) } : undefined}
				next={following ? { href: href(following), label: labelOf(following) } : undefined}
			/>
		</article>
		<PageToc items={toc} />
		</div>
	</div>
</Base>

<script>
	import { initToc } from "../lib/toc";

	initToc();
</script>
