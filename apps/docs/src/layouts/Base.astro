---
import "../styles/global.css";
// Fuentes de lo que se ve al cargar: precargarlas evita pintar con la de reserva y que el texto se recoloque al
// llegar (CLS de 0,2 en Lighthouse móvil; Geist Mono es la de los `<code>` en línea, que crecían de 20 a 22px). Mismo fichero que usa fonts.css, así que no se descarga dos veces.
// Favicon: el icono de app de Regula en su variante de favicon (sólido), con PNG de 32px y el de iOS de respaldo
import appleTouchIcon from "@jotis-me/icons/app-icons/regula-apple-touch-icon.png?no-inline";
import favicon from "@jotis-me/icons/app-icons/regula-favicon.svg?no-inline";
import favicon32 from "@jotis-me/icons/app-icons/regula-favicon-32.png?no-inline";
import bricolage from "@jotis-me/tokens/fonts/BricolageGrotesque-Variable-latin.woff2?url";
import geist from "@jotis-me/tokens/fonts/Geist-Variable.woff2?url";
import geistMono from "@jotis-me/tokens/fonts/GeistMono-Variable.woff2?url";
import CopyToast from "../components/CopyToast.astro";
import SideNav from "../components/SideNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ThemeScript from "../components/ThemeScript.astro";

interface Props {
	title: string;
	description?: string;
	/** A todo el ancho, sin navegación lateral ni márgenes (la portada). */
	wide?: boolean;
	/** Solo el contenido, sin cabecera, navegación ni pie (los lienzos a tamaño real). */
	bare?: boolean;
}
const {
	title,
	description = "Las reglas de diseño, los tokens y los componentes de la suite jotis.me.",
	wide = false,
	bare = false,
} = Astro.props;
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<ThemeScript />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href={favicon} type="image/svg+xml" />
		<link rel="icon" href={favicon32} type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href={appleTouchIcon} />
		<link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={bricolage} as="font" type="font/woff2" crossorigin />
		<title>{title === "Regula" ? "Regula · jotis.me" : `${title} · Regula`}</title>
		<meta name="description" content={description} />
		<slot name="head" />
	</head>
	<body class="min-h-screen bg-primary text-md text-primary antialiased">
		{!bare && <SiteHeader />}
		{
			bare ? (
				<main id="contenido">
					<slot />
				</main>
			) : wide ? (
				<main id="contenido" data-pagefind-body>
					<slot />
				</main>
			) : (
				<div class="mx-auto flex max-w-[1440px]">
					<aside class="sticky top-0 hidden h-screen w-72 shrink-0 overflow-y-auto shadow-[inset_-1px_0_0_var(--border-secondary)] lg:block">
						<SideNav current={current} />
					</aside>
					<div class="flex min-w-0 flex-1 flex-col">
						<main id="contenido" data-pagefind-body class="flex-1 px-4 py-8 lg:px-8 lg:py-12">
							<slot />
						</main>
					</div>
				</div>
			)
		}
		{!bare && <SiteFooter />}
		{!bare && <CopyToast />}
	</body>
</html>
