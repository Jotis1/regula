---
import pkg from "@jotis-me/react/package.json";
import "../styles/global.css";
import { getCollection } from "astro:content";
// Fuentes de lo que se ve al cargar: precargarlas evita pintar con la de reserva y que el texto se recoloque al
// llegar (CLS de 0,2 en Lighthouse móvil; Geist Mono es la de los `<code>` en línea, que crecían de 20 a 22px). Mismo fichero que usa fonts.css, así que no se descarga dos veces.
import bricolage from "@jotis-me/tokens/fonts/BricolageGrotesque-Variable-latin.woff2?url";
import geist from "@jotis-me/tokens/fonts/Geist-Variable.woff2?url";
import geistMono from "@jotis-me/tokens/fonts/GeistMono-Variable.woff2?url";
import CopyToast from "../components/CopyToast.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ThemeScript from "../components/ThemeScript.astro";
import { withComponents } from "../nav";

interface Props {
	title: string;
	description?: string;
}
const { title, description = "Las reglas de diseño, los tokens y los componentes de la suite jotis.me." } =
	Astro.props;
const current = Astro.url.pathname;
const nav = withComponents(
	(await getCollection("components")).map((c) => ({ name: c.data.name, slug: c.id })),
);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<ThemeScript />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={bricolage} as="font" type="font/woff2" crossorigin />
		<title>{title === "Regula" ? "Regula · jotis.me" : `${title} · Regula`}</title>
		<meta name="description" content={description} />
		<slot name="head" />
	</head>
	<body class="min-h-screen bg-primary text-md text-primary antialiased">
		<SiteHeader />
		<div class="mx-auto flex max-w-[1440px]">
			<aside class="sticky top-0 hidden h-screen w-72 shrink-0 flex-col gap-6 overflow-y-auto px-4 py-6 shadow-[inset_-1px_0_0_var(--border-secondary)] lg:flex">
				<nav aria-label="Documentación" class="flex flex-col gap-5">
					{
						nav
							.filter((s) => s.items.length > 0)
							.map((section) => (
								<div class="flex flex-col gap-1">
									<p class="px-2 text-xs font-semibold text-quaternary">{section.title}</p>
									<ul class="flex flex-col">
										{section.items.map((item) => (
											<li>
												<a
													href={item.href}
													aria-current={current === item.href ? "page" : undefined}
													class:list={[
														"block rounded-md px-2 py-1.5 text-sm font-medium text-secondary transition-colors duration-100 hover:bg-primary_hover hover:text-secondary_hover",
														current === item.href && "bg-secondary_hover text-primary",
													]}
												>
													{item.label}
												</a>
											</li>
										))}
									</ul>
								</div>
							))
					}
				</nav>
			</aside>
			<div class="flex min-w-0 flex-1 flex-col">
				<main id="contenido" data-pagefind-body class="flex-1 px-4 py-8 lg:px-8 lg:py-12">
					<slot />
				</main>
				<footer class="border-t border-secondary px-4 py-6 text-sm text-tertiary lg:px-8">
					Documenta <code class="font-mono text-code-xs text-secondary">@jotis-me/*</code> v{pkg.version} · Código MIT
				</footer>
			</div>
		</div>
		<CopyToast />
	</body>
</html>
