---
// Layout de las páginas .mdx de src/pages (hoy, /start/install/): la misma composición que los fundamentos, con
// migas, índice y anterior/siguiente. Astro le pasa el frontmatter, los títulos y la ruta del fichero.
import FoundationPage from "./FoundationPage.astro";

interface Props {
	frontmatter: { title: string; description?: string; slug?: string };
	headings: { depth: number; slug: string; text: string }[];
	file: string;
}
const { frontmatter, headings, file } = Astro.props;
const normalized = file.replaceAll("\\", "/");
const source = normalized.slice(normalized.indexOf("apps/docs/"));
---

<FoundationPage
	slug={frontmatter.slug ?? ""}
	title={frontmatter.title}
	description={frontmatter.description}
	headings={headings}
	source={source}
>
	<slot />
</FoundationPage>
