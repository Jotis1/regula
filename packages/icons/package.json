{
	"name": "@jotis-me/icons",
	"version": "0.0.0",
	"description": "Iconos de línea de la suite jotis.me en React y SVG, e iconos de app.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Jotis1/regula.git",
		"directory": "packages/icons"
	},
	"homepage": "https://regula.jotis.me",
	"files": [
		"dist"
	],
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./app-icon": {
			"types": "./dist/app-icon.d.ts",
			"default": "./dist/app-icon.js"
		},
		"./svg/*": "./dist/svg/*",
		"./app-icons/*": "./dist/app-icons/*",
		"./hand-drawn/*": "./dist/hand-drawn/*",
		"./patterns/*": "./dist/patterns/*",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bun run scripts/generate.ts && tsc -p tsconfig.build.json && bun run scripts/assets.ts",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit",
		"check:package": "publint && attw --pack . --profile esm-only"
	},
	"peerDependencies": {
		"react": "^19.3.1"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@playwright/test": "^1.64.1",
		"@resvg/resvg-js": "^2.6.2",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^30.1.3",
		"publint": "^0.3.25",
		"react-dom": "^19.3.1"
	}
}
