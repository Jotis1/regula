{
	"name": "@jotis-me/react",
	"version": "0.6.0",
	"description": "Componentes React de la suite jotis.me para Next.js y Astro, con Tailwind CSS v4.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Jotis1/regula.git",
		"directory": "packages/react"
	},
	"homepage": "https://regula.jotis.me",
	"files": [
		"dist",
		"styles.css"
	],
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./styles.css": "./styles.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"check:colors": "bun run scripts/check-colors.ts src",
		"check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css",
		"check:size": "bun run scripts/check-size.ts"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.4",
		"@jotis-me/icons": "workspace:*",
		"@jotis-me/tokens": "workspace:*",
		"clsx": "^2.1.1",
		"react-aria-components": "^1.22.1",
		"tailwind-merge": "^3.7.0"
	},
	"peerDependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4.3.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@tailwindcss/node": "^4.3.3",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"axe-core": "^4.14.0",
		"jsdom": "^30.1.3",
		"publint": "^0.3.25",
		"vitest": "^5"
	}
}
