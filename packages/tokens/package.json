{
	"name": "@jotis-me/tokens",
	"version": "0.4.0",
	"description": "Tokens de diseño de la suite jotis.me: variables CSS en claro y oscuro, tema de Tailwind v4 y fuentes.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Jotis1/regula.git",
		"directory": "packages/tokens"
	},
	"homepage": "https://regula.jotis.me",
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./tokens.css": "./dist/tokens.css",
		"./theme.css": "./dist/theme.css",
		"./fonts.css": "./dist/fonts.css",
		"./tokens.json": "./dist/tokens.json",
		"./fonts/*": "./dist/fonts/*",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bun run scripts/build.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"test:e2e": "playwright test",
		"check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./tokens.css ./theme.css ./fonts.css"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/node": "^4.3.3",
		"@types/node": "^26.6.6",
		"geist": "^1.8.2",
		"publint": "^0.3.25",
		"tailwindcss": "^4.3.3",
		"vitest": "^5"
	}
}
