{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!reference",
			"!packages/assets/assets",
			"!scripts/artifact/static",
			"!**/dist",
			"!**/.astro",
			"!**/.next",
			"!openspec",
			"!.claude",
			"!.changeset/*.md",
			"!**/*.generated.*",
			"!packages/assets/src/{logos,payments,cursors}.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 110
	},
	"markdown": { "formatter": { "enabled": false } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "error",
				"noTsIgnore": "error",
				"noConsole": {
					"level": "error",
					"options": { "allow": ["error", "warn"] }
				}
			},
			"style": {
				"noEnum": "error",
				"noNonNullAssertion": "error",
				"noDefaultExport": "error",
				"useFilenamingConvention": {
					"level": "error",
					"options": { "requireAscii": true, "filenameCases": ["kebab-case"] }
				},
				"useImportType": "error"
			},
			"performance": {
				"noNamespaceImport": "error",
				"noReExportAll": "error"
			},
			"a11y": {
				"useValidAriaRole": {
					"level": "error",
					"options": {
						"ignoreNonDom": true
					}
				}
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.tsx", "**/*.astro"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": {
							"level": "error",
							"options": {
								"requireAscii": true,
								"strictCase": false,
								"filenameCases": ["PascalCase", "kebab-case"]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/scripts/**", "**/test/**", "**/e2e/**", "**/*.config.{ts,mts,js,mjs}"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/app/**/{page,layout,template,loading,error,global-error,not-found,default,opengraph-image,twitter-image,icon,apple-icon,sitemap,robots,manifest}.{ts,tsx}",
				"**/*.config.{ts,mts,js,mjs}"
			],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		}
	]
}
