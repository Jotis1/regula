---
import "../styles/global.css";

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<title>{title} - Ejemplo Astro</title>
	</head>
	<body class="bg-primary p-8 text-primary antialiased">
		<a href="#contenido" class="fixed -top-24 left-4 z-60 rounded-lg bg-primary_alt px-3 py-2 text-sm font-semibold text-primary shadow-lg focus:top-3 focus-visible:outline-none">Saltar al contenido</a>
		<slot />
	</body>
</html>
