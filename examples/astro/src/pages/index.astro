---
// Solo componentes estáticos: se pintan en el servidor y no envían JavaScript.
import { Button, CloseButton } from "@jotis-me/react";
import { Calendar, CheckCircle, Plus } from "@untitledui/icons";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Estáticos">
	<main class="flex flex-col gap-6">
		<h1 class="font-display text-display-sm font-semibold">Componentes estáticos</h1>
		<div class="flex flex-wrap items-center gap-3">
			<Button iconLeading={Plus}>Nuevo gasto</Button>
			<Button hierarchy="secondary">Cancelar</Button>
			<Button hierarchy="link-color" href="/interactivo/">Ver los interactivos</Button>
			<CloseButton />
			<span class="text-fg-brand-primary"><CheckCircle size={24} role="img" aria-label="Correcto" aria-hidden={undefined} /></span>
			<!-- Un icono suelto: se pinta en el servidor, sin enviar JavaScript -->
			<span id="svg-suelto" class="text-fg-tertiary"><Calendar size={24} /></span>
		</div>
	</main>
</Layout>
