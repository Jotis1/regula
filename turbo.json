{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["VERCEL"],
			"outputs": ["dist/**", ".vercel/output/**", ".next/**", "!.next/cache/**"]
		},
		"typecheck": {
			"dependsOn": ["build"]
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": ["coverage/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
