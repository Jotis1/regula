{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"typecheck": {
			"dependsOn": ["build"]
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": ["coverage/**"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/reference/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
