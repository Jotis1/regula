{
	"name": "regula",
	"private": true,
	"description": "Sistema de diseño de la suite jotis.me",
	"license": "MIT",
	"packageManager": "bun@1.4.3",
	"workspaces": [
		"packages/*",
		"apps/*",
		"examples/*",
		"scripts/artifact"
	],
	"scripts": {
		"build": "turbo run build",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"lint": "biome check .",
		"check:reference": "bun run scripts/check-reference.ts",
		"artifact:build": "bun run --cwd scripts/artifact artifact:build",
		"format": "biome format --write .",
		"ci": "biome ci . && turbo run typecheck test build",
		"changeset": "changeset",
		"version-packages": "changeset version && bun install && biome format --write packages",
		"release": "bun run scripts/release.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@changesets/cli": "^3.0.3",
		"turbo": "^2.11.10",
		"typescript": "^7.0.2"
	},
	"patchedDependencies": {
		"@untitledui/country-flags@0.0.17": "patches/@untitledui%2Fcountry-flags@0.0.17.patch",
		"@untitledui/file-icons@0.0.9": "patches/@untitledui%2Ffile-icons@0.0.9.patch"
	}
}
